@{
    ViewData["Title"] = "AdvisoryBoard";
}

@{
    ViewData["Title"] = "Two Pictures Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My Website</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <style>
        .picture-row {
            margin-bottom: 20px; /* Adjust the spacing between rows */
        }
        .picture-img {
            width: 100%; /* Make the image responsive */
            height: auto; /* Maintain aspect ratio */
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- First Row -->
        <div class="row picture-row">
            <div class="col-12 text-center">
                <img src="~/staticpagesimages/kurul-ust.png" alt="Picture 1" class="picture-img">
            </div>
        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>


