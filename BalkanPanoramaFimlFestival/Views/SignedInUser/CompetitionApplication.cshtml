    @* COMPETITION CATEGORY*@
    @* ------------------------------------------------------------------------------------------------------------ *@
    @* Container Border Color Script *@
    <script>
        function validateCompetitionCategory() {
            var categoryContainer = document.getElementById('movie-category-container');
            var categoryInputs = categoryContainer.querySelectorAll('input[type="radio"]');
            var categorySelected = false;

            // Check if any radio button is selected
            categoryInputs.forEach(function (input) {
                if (input.checked) {
                    categorySelected = true;
                }
            });

            // Update container border color based on the selection
            if (categorySelected) {
                categoryContainer.classList.add('border-success');
                categoryContainer.classList.remove('border-danger');
            } else {
                categoryContainer.classList.add('border-danger');
                categoryContainer.classList.remove('border-success');
            }

            return categorySelected; // Return whether the category is selected
        }

        // Attach the validation function to the form submit event
        document.querySelector('form').addEventListener('submit', function (event) {
            if (!validateCompetitionCategory()) {
                event.preventDefault(); // Prevent form submission if no category is selected

                // Scroll to and focus on the competition category container
                var categoryContainer = document.getElementById('movie-category-container');
                categoryContainer.scrollIntoView({ behavior: 'smooth' });

                // Wait for the scroll to complete before focusing
                setTimeout(function () {
                    categoryContainer.focus(); // Make sure to have tabindex="0" or a focusable element inside
                }, 500); // Adjust timing if needed
            }
        });

        // Attach the validation function to each radio button's change event
        document.querySelectorAll('#movie-category-container input[type="radio"]').forEach(function (input) {
            input.addEventListener('change', validateCompetitionCategory);
        });
    </script>
