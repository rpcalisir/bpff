        @* <-- --> *@

        @* <-- PRODUCER --> *@
        <b2 class="col-md-10 offset-md-1"><strong>PRODUCER</strong></b2>

        <div class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="row mb-3 col-md-12">
