    @* <-- DOWNLOADABLE SCREENING COPY OF THE FILM --> *@
    @* ------------------------------------------------------------------------------------------------------------ *@
    <script>
        $(document).ready(function () {
            // Function to validate all text inputs in the downloadable screening copy section
            function validateDownloadableScreeningCopyInputs() {
                var allDownloadableInputsFilled = true;

                // Check each input in the downloadable screening copy container
                $('#downloadable-screeningcopy-container input[type="text"]').each(function () {
                    if ($(this).val().trim() === '') {
                        $(this).addClass('is-invalid').removeClass('is-valid');
                        allDownloadableInputsFilled = false;
                    } else {
                        $(this).addClass('is-valid').removeClass('is-invalid');
                    }
                });

                // Enable or disable the checkbox based on input validation
                if (allDownloadableInputsFilled) {
                    $('#DownloadableCopyCheck').prop('disabled', false);
                } else {
                    $('#DownloadableCopyCheck').prop('disabled', true).removeClass('is-valid is-invalid');
                }
            }

            // Validate inputs on typing in the downloadable screening copy section
            $('#downloadable-screeningcopy-container input[type="text"]').on('input', function () {
                validateDownloadableScreeningCopyInputs();
            });

            // Handle checkbox state and color for the downloadable screening copy section
            $('#DownloadableCopyCheck').on('change', function () {
                if ($(this).is(':checked')) {
                    $(this).addClass('is-valid').removeClass('is-invalid');
                    $('#DownloadableCopyCheckError').addClass('d-none');
                } else {
                    $(this).addClass('is-invalid').removeClass('is-valid');
                }
            });

            // Prevent form submission if checkbox is not checked in the downloadable screening copy section
            $('form').on('submit', function (e) {
                validateDownloadableScreeningCopyInputs(); // Ensure inputs are validated before submission

                if (!$('#DownloadableCopyCheck').is(':checked')) {
                    e.preventDefault();

                    // Focus the checkbox if inputs are filled but checkbox is not checked
                    if ($('#DownloadableCopyCheck').is(':disabled') == false && !$('#DownloadableCopyCheck').is(':checked')) {
                        $('#DownloadableCopyCheck').focus().addClass('is-invalid');
                        $('#DownloadableCopyCheckError').removeClass('d-none');
                        $('html, body').animate({
                            scrollTop: $('#DownloadableCopyCheck').offset().top
                        }, 500);
                    }

                    // Show error messages and focus on invalid inputs
                    else if ($('#DownloadableCopyCheck').is(':disabled') == true) {
                        $('#downloadable-screeningcopy-container input.is-invalid:first').focus();
                    }
                }
            });
        });
    </script>
