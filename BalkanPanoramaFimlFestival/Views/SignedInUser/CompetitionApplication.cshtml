    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Get references to the "Copy From Director into Producer" checkbox
            const copyFromDirectorToProducerCheckbox = document.getElementById('producerSameAsDirector');

            // Get references to the Director fields
            const directorFields = {
                name: document.getElementById('DirectorName'),
                company: document.getElementById('DirectorCompany'),
                email: document.getElementById('DirectorEmail'),
                phone: document.getElementById('director-phone'),
                country: document.getElementById('CountrySelectDirector')
            };

            // Get references to the Producer fields
            const producerFields = {
                name: document.getElementById('ProducerName'),
                company: document.getElementById('ProducerCompany'),
                email: document.getElementById('ProducerEmail'),
                phone: document.getElementById('producer-phone'),
                country: document.getElementById('CountrySelectProducer')
            };

            // Get error message element
            const producerSameAsDirectorError = document.getElementById('producerSameAsDirectorError');

            function copyValuesFromDirectorToProducer() {
                // Copy values from Director fields to Producer fields
                producerFields.name.value = directorFields.name.value;
                producerFields.company.value = directorFields.company.value;
                producerFields.email.value = directorFields.email.value;
                producerFields.phone.value = directorFields.phone.value;
                producerFields.country.value = directorFields.country.value;

                // Handle country name input if applicable
                document.getElementById('ProducerCountryName').value = document.getElementById('DirectorCountryName').value;

                // Manually trigger change event to make country field green
                const event = new Event('change');
                producerFields.country.dispatchEvent(event);

                // Remove red color from Producer fields
                Object.values(producerFields).forEach(field => field.classList.remove('is-invalid'));
            }

            function validateDirectorFields() {
                return Object.values(directorFields).every(field => {
                    if (field.tagName === 'SELECT') {
                        return field.value !== '';
                    }
                    return field.value.trim() !== '';
                });
            }

            copyFromDirectorToProducerCheckbox.addEventListener('change', function () {
                if (copyFromDirectorToProducerCheckbox.checked) {
                    if (!validateDirectorFields()) {
                        producerSameAsDirectorError.textContent = 'Please fill all fields in the Director section.';
                        producerSameAsDirectorError.style.display = 'block';
                        copyFromDirectorToProducerCheckbox.checked = false; // Uncheck if validation fails
                    } else {
                        producerSameAsDirectorError.style.display = 'none';
                        // Clear Producer fields before copying
                        Object.values(producerFields).forEach(field => {
                            if (field.tagName === 'SELECT') {
                                field.value = '';
                            } else {
                                field.value = '';
                            }
                        });
                        copyValuesFromDirectorToProducer();
                    }
                } else {
                    // Clear Producer fields if unchecked
                    Object.values(producerFields).forEach(field => {
                        if (field.tagName === 'SELECT') {
                            field.value = '';
                        } else {
                            field.value = '';
                        }
                    });
                }
            });
        });
    </script>

