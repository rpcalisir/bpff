    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function validateMediaContainer() {
                var mediaContainer = document.getElementById('media-container');
                var requiredInputs = mediaContainer.querySelectorAll('input[required]');
                var allValid = true;

                // Helper function to check if a file input is valid
                function isFileInputValid(input) {
                    return input.files && input.files.length > 0;
                }

                // Helper function to check text input validity
                function isTextInputValid(input) {
                    return input.value.trim() !== "";
                }

                // Helper function to handle optional checkboxes
                function shouldValidateInput(input, checkboxId) {
                    var checkbox = document.getElementById(checkboxId);
                    return !checkbox || !checkbox.checked;
                }

                // Validate required inputs
                requiredInputs.forEach(function (input) {
                    if (input.type === 'file') {
                        if (!isFileInputValid(input)) {
                            allValid = false;
                            input.classList.add('border-danger');
                            input.classList.remove('border-success');
                        } else {
                            input.classList.add('border-success');
                            input.classList.remove('border-danger');
                        }
                    } else {
                        if (!isTextInputValid(input)) {
                            allValid = false;
                            input.classList.add('border-danger');
                            input.classList.remove('border-success');
                        } else {
                            input.classList.add('border-success');
                            input.classList.remove('border-danger');
                        }
                    }
                });

                // Manually validate fields without the "required" attribute but with optional checkboxes
                var optionalFields = [
                    {
                        inputFile: document.getElementById('UploadedBestActorPhoto'),
                        inputText: document.getElementById('UploadedBestActorPhotoName'),
                        checkbox: document.getElementById('UploadedBestActorPhotoOptional')
                    },
                    {
                        inputFile: document.getElementById('UploadedBestActressPhoto'),
                        inputText: document.getElementById('UploadedBestActressPhotoName'),
                        checkbox: document.getElementById('UploadedBestActressPhotoOptional')
                    }
                ];

                optionalFields.forEach(function (field) {
                    if (shouldValidateInput(field.inputFile, field.checkbox.id)) {
                        // Validate file input
                        if (!isFileInputValid(field.inputFile)) {
                            allValid = false;
                            field.inputFile.classList.add('border-danger');
                            field.inputFile.classList.remove('border-success');
                        } else {
                            field.inputFile.classList.add('border-success');
                            field.inputFile.classList.remove('border-danger');
                        }

                        // Validate text input
                        if (!isTextInputValid(field.inputText)) {
                            allValid = false;
                            field.inputText.classList.add('border-danger');
                            field.inputText.classList.remove('border-success');
                        } else {
                            field.inputText.classList.add('border-success');
                            field.inputText.classList.remove('border-danger');
                        }
                    } else {
                        // Reset borders if optional checkbox is checked
                        field.inputFile.classList.remove('border-danger', 'border-success');
                        field.inputText.classList.remove('border-danger', 'border-success');
                    }
                });

                // Update container border color based on the validity of inputs
                if (allValid) {
                    mediaContainer.classList.add('border-success');
                    mediaContainer.classList.remove('border-danger');
                } else {
                    mediaContainer.classList.add('border-danger');
                    mediaContainer.classList.remove('border-success');
                }

                return allValid; // Return whether the media is valid
            }

            // Attach the validation function to the form submit event
            document.querySelector('form').addEventListener('submit', function (event) {
                if (!validateMediaContainer()) {
                    event.preventDefault(); // Prevent form submission if there are errors
                    console.log("Form submission prevented due to container validation errors.");
                }
            });

            // Attach the validation function to each required input's input event
            document.querySelectorAll('#media-container input').forEach(function (input) {
                input.addEventListener('input', validateMediaContainer);
            });

            // Initial validation on page load
            validateMediaContainer();
        });
    </script>

    @* UploadedMoviePictures Upload Check Script *@
    <script>
        function validateMoviePicturesUpload() {
            var uploadedPicturesInput = document.getElementById('UploadedMoviePictures');
            var UploadedMoviePicturesErrorMessages = document.getElementById('UploadedMoviePicturesErrorMessages');
            var maxFiles = 5;
            var maxSizeInMB = 10;
            var maxSizeInBytes = maxSizeInMB * 1024 * 1024;

            var totalSize = 0;
            var files = uploadedPicturesInput.files;
            var hasFiles = files.length > 0;

            // Calculate total file size
            for (var i = 0; i < files.length; i++) {
                totalSize += files[i].size;
            }

            var tooManyFiles = files.length > maxFiles;
            var exceedsSizeLimit = totalSize > maxSizeInBytes;

            // Prepare error messages
            var messages = [];
            if (!hasFiles) {
                messages.push('At least 1 movie picture must be uploaded.');
            }
            if (tooManyFiles) {
                messages.push(`You can upload a maximum of ${maxFiles} pictures.`);
            }
            if (exceedsSizeLimit) {
                messages.push(`The total size of the uploaded pictures must be less than ${maxSizeInMB} MB.`);
            }

            // Show or clear error messages and set border color based on validation
            if (messages.length > 0) {
                UploadedMoviePicturesErrorMessages.textContent = messages.join(' ');
                uploadedPicturesInput.style.borderColor = 'red'; // Set border color to red on error
            } else {
                UploadedMoviePicturesErrorMessages.textContent = '';
                uploadedPicturesInput.style.borderColor = 'green'; // Set border color to green if no error
            }
        }

        // Attach the validation function to the file input's change event
        document.getElementById('UploadedMoviePictures').addEventListener('change', function () {
            validateMoviePicturesUpload();
        });

        // Validate the file input on form submission
        document.querySelector('form').addEventListener('submit', function (event) {
            var uploadedPicturesInput = document.getElementById('UploadedMoviePictures');
            var totalSize = 0;
            var files = uploadedPicturesInput.files;
            var maxFiles = 5;
            var maxSizeInBytes = 10 * 1024 * 1024;

            // Calculate total file size
            for (var i = 0; i < files.length; i++) {
                totalSize += files[i].size;
            }

            var tooManyFiles = files.length > maxFiles;
            var exceedsSizeLimit = totalSize > maxSizeInBytes;

            if (files.length === 0 || tooManyFiles || exceedsSizeLimit) {
                validateMoviePicturesUpload();
                event.preventDefault(); // Prevent form submission if validation fails
                uploadedPicturesInput.focus(); // Add focus to the file input
            }
        });
