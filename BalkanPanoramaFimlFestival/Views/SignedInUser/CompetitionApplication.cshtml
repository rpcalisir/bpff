    @* Country Selector Script *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const countrySelectDirector = document.getElementById('CountrySelectDirector');
            const countrySelectProducer = document.getElementById('CountrySelectProducer');
            const countrySelectApplicant = document.getElementById('CountrySelectApplicant');

            const countryErrorDirector = document.getElementById('CountryErrorDirector');
            const countryErrorProducer = document.getElementById('CountryErrorProducer');
            const countryErrorApplicant = document.getElementById('CountryErrorApplicant');

            // Fetch the list of countries from an external API and populate the selectors
            fetch('https://restcountries.com/v3.1/all')
                .then(response => response.json())
                .then(data => {
                    data.forEach(country => {
                        if (country.name && country.cca2) {
                            var optionDirector = document.createElement('option');
                            optionDirector.value = country.cca2;
                            optionDirector.textContent = country.name.common;
                            countrySelectDirector.appendChild(optionDirector);

                            var optionProducer = document.createElement('option');
                            optionProducer.value = country.cca2;
                            optionProducer.textContent = country.name.common;
                            countrySelectProducer.appendChild(optionProducer);

                            var optionApplicant = document.createElement('option');
                            optionApplicant.value = country.cca2;
                            optionApplicant.textContent = country.name.common;
                            countrySelectApplicant.appendChild(optionApplicant);
                        }
                    });
                })
                .catch(error => {
                    console.error('Error fetching countries:', error);
                });

            // Set initial styles for all selectors
            countrySelectDirector.style.borderColor = 'red';
            countrySelectProducer.style.borderColor = 'red';
            countrySelectApplicant.style.borderColor = 'red';

            // Director Country Selector
            countrySelectDirector.addEventListener('change', function () {
                if (this.value) {
                    this.style.borderColor = 'green';
                    countryErrorDirector.style.display = 'none';
                } else {
                    this.style.borderColor = 'red';
                    countryErrorDirector.style.display = 'block';
                }
            });

            // Producer Country Selector
            countrySelectProducer.addEventListener('change', function () {
                if (this.value) {
                    this.style.borderColor = 'green';
                    countryErrorProducer.style.display = 'none';
                } else {
                    this.style.borderColor = 'red';
                    countryErrorProducer.style.display = 'block';
                }
            });

            // Applicant Country Selector
            countrySelectApplicant.addEventListener('change', function () {
                if (this.value) {
                    this.style.borderColor = 'green';
                    countryErrorApplicant.style.display = 'none';
                } else {
                    this.style.borderColor = 'red';
                    countryErrorApplicant.style.display = 'block';
                }
            });

            // Form submission handler
            document.querySelector('form').addEventListener('submit', function (event) {
                let valid = true;

                // Validate Director Country
                if (!countrySelectDirector.value) {
                    countrySelectDirector.focus();
                    countrySelectDirector.style.borderColor = 'red';
                    countryErrorDirector.style.display = 'block';
                    valid = false;
                }

                // Validate Producer Country
                if (!countrySelectProducer.value) {
                    if (valid) {
                        countrySelectProducer.focus();
                    }
                    countrySelectProducer.style.borderColor = 'red';
                    countryErrorProducer.style.display = 'block';
                    valid = false;
