    @* Movie Language Selector *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const languageSelectMovie = document.getElementById('LanguageSelectMovie');
            const languageErrorMovie = document.getElementById('LanguageErrorMovie');

            // Fetch the list of languages from an external API and populate the selectors
            fetch('https://restcountries.com/v3.1/all')
                .then(response => response.json())
                .then(data => {
                    // Create a Set to avoid duplicate languages
                    const languages = new Set();

                    // Extract languages from the data
                    data.forEach(country => {
                        if (country.languages) {
                            Object.values(country.languages).forEach(language => {
                                languages.add(language);
                            });
                        }
                    });

                    // Get the language selector element
                    const languageSelector = document.getElementById('LanguageSelectMovie');

                    // Populate the language selector with options
                    languages.forEach(language => {
                        const option = document.createElement('option');
                        option.value = language;
                        option.textContent = language;
                        languageSelector.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error('Error fetching countries:', error);
                });

            // Set initial styles for selector
            languageSelectMovie.style.borderColor = 'red';

            // Movie Language Selector
            languageSelectMovie.addEventListener('change', function () {
                if (this.value) {
                    this.style.borderColor = 'green';
                    languageErrorMovie.style.display = 'none';
                } else {
                    this.style.borderColor = 'red';
                    languageErrorMovie.style.display = 'block';
                }
            });

            // Form submission handler
            document.querySelector('form').addEventListener('submit', function (event) {
                let valid = true;

                // Validate Movie Language
                if (!languageSelectMovie.value) {
                    languageSelectMovie.focus();
                    languageSelectMovie.style.borderColor = 'red';
                    languageErrorMovie.style.display = 'block';
                    valid = false;
                }

                // Prevent form submission if validation fails
                if (!valid) {
                    event.preventDefault();
                }
            });
        });
    </script>
