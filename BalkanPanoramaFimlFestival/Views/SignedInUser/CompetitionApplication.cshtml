    @* ProductionYear - Color Script *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var productionYearSelect = document.getElementById('ProductionYear');
            var productionYearError = document.getElementById('ProductionYearError');
            var form = document.querySelector('form');

            // Set the initial border color to red
            productionYearSelect.classList.add('border-danger');

            // Validate the form on submit
            form.addEventListener('submit', function (event) {
                var selectedYear = productionYearSelect.value;

                // Reset the error message
                productionYearError.style.display = 'none';
                productionYearError.textContent = '';

                if (selectedYear === '') {
                    // Show error message and set the border color to red
                    productionYearError.textContent = 'Please select a production year.';
                    productionYearError.style.display = 'block';
                    productionYearSelect.classList.remove('border-success');
                    productionYearSelect.classList.add('border-danger');
                    event.preventDefault(); // Prevent form submission
                    // Set focus to the year selector
                    productionYearSelect.focus();
                } else {
                    // Remove error and set the border color to green
                    productionYearSelect.classList.remove('border-danger');
                    productionYearSelect.classList.add('border-success');
                }
            });

            // Add an event listener to update the border color when a year is selected
            productionYearSelect.addEventListener('change', function () {
                var selectedYear = productionYearSelect.value;

                if (selectedYear !== '') {
                    // Clear the error message and set the border color to green
                    productionYearError.style.display = 'none';
                    productionYearError.textContent = '';
                    productionYearSelect.classList.remove('border-danger');
                    productionYearSelect.classList.add('border-success');
                } else {
                    // Reset to default color (black)
                    productionYearSelect.classList.remove('border-success');
                    productionYearSelect.classList.add('border-black');
                }
            });
        });
    </script>

    @* MovieTimeLength Selector *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const movieTimeLength = document.getElementById('MovieTimeLength');
            const movieTimeLengthError = document.getElementById('MovieTimeLengthError');
            const competitionCategoryRadios = document.querySelectorAll('input[name="CompetitionCategory"]');

            // Radio button change event listener
            competitionCategoryRadios.forEach(radio => {
                radio.addEventListener('change', function () {
                    if (this.checked) {
                        movieTimeLength.removeAttribute('disabled'); // Enable the selector
                        movieTimeLength.innerHTML = ''; // Clear previous options
                        movieTimeLength.append(new Option("Select Time Length", "")); // Add placeholder option
                        movieTimeLengthError.textContent = ''; // Clear any existing error message

                        // Populate the selector based on selected radio button
                        let options = [];
                        if (this.value === 'Option1' || this.value === 'Option3') {
                            options = generateOptions(60, 240);
                        } else if (this.value === 'Option2') {
                            options = generateOptions(5, 25);
                        }
                        options.forEach(option => movieTimeLength.append(option));

                        // Add initial invalid state to the selector
                        movieTimeLength.classList.add('is-invalid');
                    }
                });
            });

            // MovieTimeLength change event to handle valid selection
            movieTimeLength.addEventListener('change', function () {
                if (this.value) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                    movieTimeLengthError.textContent = ''; // Clear the error message
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                    movieTimeLengthError.textContent = 'Please select a time length.'; // Show error message
                }
            });

            function generateOptions(min, max) {
                let options = [];
                for (let i = min; i <= max; i++) {
                    options.push(new Option(i + ' minutes', i));
                }
                return options;
            }
        });

        document.querySelector('form').addEventListener('submit', function (event) {
            const movieTimeLength = document.getElementById('MovieTimeLength');
            const movieTimeLengthError = document.getElementById('MovieTimeLengthError');

            if (movieTimeLength.disabled || !movieTimeLength.value) {
                movieTimeLength.focus(); // Bring focus to the selector
                movieTimeLength.classList.remove('is-valid');
                movieTimeLength.classList.add('is-invalid');
                movieTimeLengthError.textContent = 'Please select a time length.'; // Show error message
                event.preventDefault(); // Prevent form submission
            }
        });
    </script>

    @* Movie Language Selector *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const languageSelectMovie = document.getElementById('LanguageSelectMovie');
            const languageErrorMovie = document.getElementById('LanguageErrorMovie');

            // Fetch the list of languages from an external API and populate the selectors
            fetch('https://restcountries.com/v3.1/all')
                .then(response => response.json())
                .then(data => {
                    // Create a Set to avoid duplicate languages
                    const languages = new Set();

                    // Extract languages from the data
                    data.forEach(country => {
                        if (country.languages) {
                            Object.values(country.languages).forEach(language => {
                                languages.add(language);
                            });
                        }
                    });

                    // Get the language selector element
                    const languageSelector = document.getElementById('LanguageSelectMovie');

                    // Populate the language selector with options
                    languages.forEach(language => {
                        const option = document.createElement('option');
                        option.value = language;
                        option.textContent = language;
                        languageSelector.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error('Error fetching countries:', error);
                });

            // Set initial styles for selector
            languageSelectMovie.style.borderColor = 'red';

            // Movie Language Selector
            languageSelectMovie.addEventListener('change', function () {
                if (this.value) {
                    this.style.borderColor = 'green';
                    languageErrorMovie.style.display = 'none';
                } else {
                    this.style.borderColor = 'red';
                    languageErrorMovie.style.display = 'block';
                }
            });

            // Form submission handler
            document.querySelector('form').addEventListener('submit', function (event) {
                let valid = true;

                // Validate Movie Language
                if (!languageSelectMovie.value) {
                    languageSelectMovie.focus();
                    languageSelectMovie.style.borderColor = 'red';
                    languageErrorMovie.style.display = 'block';
                    valid = false;
                }

                // Prevent form submission if validation fails
                if (!valid) {
                    event.preventDefault();
                }
            });
        });
    </script>
