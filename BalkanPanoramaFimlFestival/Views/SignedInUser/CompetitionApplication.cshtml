    @* Upload Pdf Border Color Handle Script *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const uploadedPdfFileInput = document.getElementById('UploadedPdfFile');
            const pdfFileOptionalCheckbox = document.getElementById('PdfFileOptional');
            const uploadedPdfFileErrorMessages = document.getElementById('UploadedPdfFileErrorMessages');
            const container = document.getElementById('film-work-operation-container');

            const maxPdfSizeInMB = 2; // Set your desired max size for PDF file
            const maxPdfSizeInBytes = maxPdfSizeInMB * 1024 * 1024;

            function validatePdfFileUpload() {
                const files = uploadedPdfFileInput.files;
                let errorMessages = [];
                let totalSize = 0;
                let pdfFileUploaded = files.length > 0;

                if (pdfFileOptionalCheckbox.checked) {
                    // Checkbox is checked, disable file input, clear files, and clear errors
                    uploadedPdfFileInput.disabled = true;
                    uploadedPdfFileInput.value = ''; // Clear the file input
                    uploadedPdfFileErrorMessages.textContent = '';
                    uploadedPdfFileInput.style.borderColor = 'green'; // Set border color to green
                    container.classList.add('border-success');
                    container.classList.remove('border-danger');
                    return true;
                } else {
                    // Enable file input if checkbox is not checked
                    uploadedPdfFileInput.disabled = false;
                }

                // Validate file
                if (files.length === 0) {
                    errorMessages.push('A PDF file must be uploaded.');
                    pdfFileUploaded = false;
                } else if (files.length > 1) {
                    errorMessages.push('You can upload only one PDF file.');
                    pdfFileUploaded = false;
                } else {
                    // Calculate total size of uploaded file
                    totalSize = files[0].size;

                    if (totalSize > maxPdfSizeInBytes) {
                        errorMessages.push(`The total size of the uploaded PDF file must be less than ${maxPdfSizeInMB} MB.`);
                        pdfFileUploaded = false;
                    }
                }

                // Update border color and error messages
                if (errorMessages.length > 0) {
                    uploadedPdfFileErrorMessages.textContent = errorMessages.join(' ');
                    uploadedPdfFileInput.style.borderColor = 'red'; // Set border color to red on error
                    container.classList.add('border-danger');
                    container.classList.remove('border-success');
                } else {
                    uploadedPdfFileErrorMessages.textContent = '';
                    uploadedPdfFileInput.style.borderColor = 'green'; // Set border color to green if no error
                    container.classList.add('border-success');
                    container.classList.remove('border-danger');
                }
            }

            // Attach event listeners
            pdfFileOptionalCheckbox.addEventListener('change', validatePdfFileUpload);
            uploadedPdfFileInput.addEventListener('change', validatePdfFileUpload);

            // Validate on form submission
            document.querySelector('form').addEventListener('submit', function (event) {
                if (!pdfFileOptionalCheckbox.checked && (uploadedPdfFileInput.files.length === 0 || uploadedPdfFileInput.files.length > 1)) {
                    validatePdfFileUpload();
                    event.preventDefault(); // Prevent form submission if validation fails
                    uploadedPdfFileInput.focus(); // Add focus to the file input
                }
            });
        });
    </script>

