    <script>
        function updateHiddenFieldApplicantCountry() {
            var applicantCountrySelect = document.getElementById('CountrySelectApplicant');
            var applicantCountryName = document.getElementById('ApplicantCountryName');

            if (applicantCountrySelect && applicantCountryName) {
                var selectedCountryText = applicantCountrySelect.options[applicantCountrySelect.selectedIndex].text;
                applicantCountryName.value = selectedCountryText;
            }
        }

        function validateApplicantInfo() {
            var applicantContainer = document.getElementById('applicant-container');
            var requiredElements = applicantContainer.querySelectorAll('input[required], select[required], textarea[required]');
            var allValid = true;

            // Check each required element
            requiredElements.forEach(function (element) {
                if (!element.value.trim()) {
                    allValid = false;
                    element.classList.add('border-danger');
                    element.classList.remove('border-success');
                } else {
                    element.classList.add('border-success');
                    element.classList.remove('border-danger');
                }
            });

            // Validate country selection separately
            var applicantCountry = document.getElementById('CountrySelectApplicant');
            var countryError = document.getElementById('CountryErrorApplicant');
            if (applicantCountry && applicantCountry.value === "") {
                allValid = false;
                applicantCountry.classList.add('border-danger');
                applicantCountry.classList.remove('border-success');
                countryError.style.display = "block";
            } else if (applicantCountry) {
                applicantCountry.classList.add('border-success');
                applicantCountry.classList.remove('border-danger');
                countryError.style.display = "none";
            }

            // Ensure container border color updates based on the validity of all required fields
            if (allValid) {
                applicantContainer.classList.add('border-success');
                applicantContainer.classList.remove('border-danger');
            } else {
                applicantContainer.classList.add('border-danger');
                applicantContainer.classList.remove('border-success');
            }

            return allValid; // Return whether the applicant info is valid
        }

        // Attach the update function to country select change event
        document.getElementById('CountrySelectApplicant').addEventListener('change', function () {
            updateHiddenFieldApplicantCountry();
            validateApplicantInfo(); // Validate on change
        });

        // Attach the validation function to the form submit event
        document.querySelector('form').addEventListener('submit', function (event) {
            if (!validateApplicantInfo()) {
                event.preventDefault(); // Prevent form submission if there are errors
            }
        });

        // Attach the validation function to each required input's input/change event
        document.querySelectorAll('#applicant-container input[required], #applicant-container select[required], #applicant-container textarea[required]').forEach(function (element) {
            element.addEventListener('input', validateApplicantInfo);
            element.addEventListener('change', validateApplicantInfo); // For select elements
        });
    </script>

    @* Same as Director or Producer Sections Handle Script *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Get references to the checkboxes
            const copyFromDirectorToApplicantCheckbox = document.getElementById('applicantSameAsDirector');
            const copyFromProducerToApplicantCheckbox = document.getElementById('applicantSameAsProducer');

            // Get references to the Director fields
            const directorFields = {
                name: document.getElementById('DirectorName'),
                company: document.getElementById('DirectorCompany'),
                email: document.getElementById('DirectorEmail'),
                phone: document.getElementById('director-phone'),
                country: document.getElementById('CountrySelectDirector')
            };

            // Get references to the Producer fields
            const producerFields = {
                name: document.getElementById('ProducerName'),
                company: document.getElementById('ProducerCompany'),
                email: document.getElementById('ProducerEmail'),
                phone: document.getElementById('producer-phone'),
                country: document.getElementById('CountrySelectProducer')
            };

            // Get references to the Applicant fields
            const applicantFields = {
                name: document.getElementById('ApplicantName'),
                company: document.getElementById('ApplicantCompany'),
                email: document.getElementById('ApplicantEmail'),
                phone: document.getElementById('applicant-phone'),
                country: document.getElementById('CountrySelectApplicant')
            };

            // Get error message elements
            const countryErrorDirector = document.getElementById('CountryErrorDirector');
            const countryErrorProducer = document.getElementById('CountryErrorProducer');
            const countryErrorApplicant = document.getElementById('CountryErrorApplicant');
            const applicantSameAsDirectorError = document.getElementById('applicantSameAsDirectorError');
            const applicantSameAsProducerError = document.getElementById('applicantSameAsProducerError');

            function copyValuesFromDirectorToApplicant() {
                applicantFields.name.value = directorFields.name.value;
                applicantFields.company.value = directorFields.company.value;
                applicantFields.email.value = directorFields.email.value;
                applicantFields.phone.value = directorFields.phone.value;
                applicantFields.country.value = directorFields.country.value;

                document.getElementById('ApplicantCountryName').value = document.getElementById('DirectorCountryName').value;

                // Trigger validation update
                updateValidation(applicantFields);

                Object.values(applicantFields).forEach(field => field.classList.remove('is-invalid'));
                clearErrorsIfFilled();
            }

            function copyValuesFromProducerToApplicant() {
                applicantFields.name.value = producerFields.name.value;
                applicantFields.company.value = producerFields.company.value;
                applicantFields.email.value = producerFields.email.value;
                applicantFields.phone.value = producerFields.phone.value;
                applicantFields.country.value = producerFields.country.value;

                document.getElementById('ApplicantCountryName').value = document.getElementById('ProducerCountryName').value;

                // Trigger validation update
                updateValidation(applicantFields);

                Object.values(applicantFields).forEach(field => field.classList.remove('is-invalid'));
                clearErrorsIfFilled();
            }

            function validateFields(fields) {
                return Object.values(fields).every(field => {
                    if (field.tagName === 'SELECT') {
                        return field.value !== '';
                    }
                    return field.value.trim() !== '';
                });
            }

            function clearApplicantFields() {
                Object.values(applicantFields).forEach(field => {
                    if (field.tagName === 'SELECT') {
                        field.value = '';
                    } else {
                        field.value = '';
                    }
                });
                document.getElementById('ApplicantCountryName').value = '';
            }

            function clearErrorsIfFilled() {
                if (validateFields(applicantFields)) {
                    countryErrorApplicant.style.display = 'none';
                    applicantSameAsDirectorError.style.display = 'none';
                    applicantSameAsProducerError.style.display = 'none';
                }
            }

            function updateValidation(fields) {
                Object.values(fields).forEach(field => {
                    if (field.tagName === 'INPUT' || field.tagName === 'TEXTAREA') {
                        const event = new Event('input', { bubbles: true });
                        field.dispatchEvent(event);
                    } else if (field.tagName === 'SELECT') {
                        const event = new Event('change', { bubbles: true });
                        field.dispatchEvent(event);
                    }
                    // Force update validation for associated error messages
                    const errorElement = document.querySelector(`[data-valmsg-for="${field.name}"]`);
                    if (errorElement) {
                        errorElement.style.display = 'none';
                    }
                });
            }

            function handleCopyFromDirectorToApplicant() {
                if (copyFromDirectorToApplicantCheckbox.checked) {
                    if (!validateFields(directorFields)) {
                        applicantSameAsDirectorError.textContent = 'Please fill all fields in the Director section.';
                        applicantSameAsDirectorError.style.display = 'block';
                        copyFromDirectorToApplicantCheckbox.checked = false;
                    } else {
                        applicantSameAsDirectorError.style.display = 'none';
                        copyValuesFromDirectorToApplicant();
                    }
                } else {
                    clearApplicantFields();
                    if (validateFields(producerFields)) {
                        countryErrorProducer.style.display = 'none';
                        applicantSameAsProducerError.style.display = 'none';
                    }
                }
            }

            function handleCopyFromProducerToApplicant() {
                if (copyFromProducerToApplicantCheckbox.checked) {
                    if (!validateFields(producerFields)) {
                        applicantSameAsProducerError.textContent = 'Please fill all fields in the Producer section.';
                        applicantSameAsProducerError.style.display = 'block';
                        copyFromProducerToApplicantCheckbox.checked = false;
                    } else {
                        applicantSameAsProducerError.style.display = 'none';
                        copyValuesFromProducerToApplicant();
                    }
                } else {
                    clearApplicantFields();
                    if (validateFields(directorFields)) {
                        countryErrorDirector.style.display = 'none';
                        applicantSameAsDirectorError.style.display = 'none';
                    }
                }
            }

            function handleCheckboxChange() {
                if (this === copyFromDirectorToApplicantCheckbox) {
                    if (copyFromDirectorToApplicantCheckbox.checked) {
                        copyFromProducerToApplicantCheckbox.checked = false;
                        handleCopyFromDirectorToApplicant();
                    } else {
                        clearApplicantFields();
                        if (validateFields(producerFields)) {
                            countryErrorProducer.style.display = 'none';
                            applicantSameAsProducerError.style.display = 'none';
                        }
                    }
                } else if (this === copyFromProducerToApplicantCheckbox) {
                    if (copyFromProducerToApplicantCheckbox.checked) {
                        copyFromDirectorToApplicantCheckbox.checked = false;
                        handleCopyFromProducerToApplicant();
                    } else {
                        clearApplicantFields();
                        if (validateFields(directorFields)) {
                            countryErrorDirector.style.display = 'none';
                            applicantSameAsDirectorError.style.display = 'none';
                        }
                    }
                }
            }

            function handleSubmit() {
                if (validateFields(applicantFields)) {
                    // Clear any existing errors related to the Director and Producer sections
                    countryErrorDirector.style.display = 'none';
                    applicantSameAsDirectorError.style.display = 'none';
                    countryErrorProducer.style.display = 'none';
                    applicantSameAsProducerError.style.display = 'none';
                }
            }

            copyFromDirectorToApplicantCheckbox.addEventListener('change', handleCheckboxChange);
            copyFromProducerToApplicantCheckbox.addEventListener('change', handleCheckboxChange);

            // Add an event listener for the submit button
            const submitButton = document.getElementById('submitButton'); // Replace with the actual ID of your submit button
            if (submitButton) {
                submitButton.addEventListener('click', handleSubmit);
            }
        });
    </script>
