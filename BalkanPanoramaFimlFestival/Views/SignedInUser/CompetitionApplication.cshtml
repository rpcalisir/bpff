        border-color: #90ee90 !important; /* Light green color */
        border-width: 2px !important; /* Bolder border */
    }

    /* Dark red border for error */
    .border-danger {
        border-color: red !important; /* Dark red color */
        /* border-width: 2px !important; /* Bolder border */
    }


    /* Director and Producer */
    /* Red border for error */
    .border-danger-director {
        border-color: #a94442 !important; /* Dark red color */
        border-width: 2px !important; /* Bolder border */
    }

    .border-danger-producer {
        border-color: #a94442 !important; /* Dark red color */
        border-width: 2px !important; /* Bolder border */
    }

    /* Light green border for success */
    .border-success-director {
        border-color: #90ee90 !important; /* Light green color */
        border-width: 2px !important; /* Bolder border */
    }

    .border-success-producer {
        border-color: #90ee90 !important; /* Light green color */
        border-width: 2px !important; /* Bolder border */
    }


    /* Movie Time Length */
    #MovieTimeLength {
        border-color: red; /* Default border color red */
    }

        #MovieTimeLength:disabled {
            background-color: #f8d7da; /* Slightly red background for disabled state */
            color: #6c757d; /* Gray text color */
        }

        #MovieTimeLength.is-valid {
            border-color: green; /* Border color turns green when valid */
        }

        #MovieTimeLength.is-invalid {
            border-color: red; /* Border color stays red when invalid */
        }
</style>

<!-- Styles for Popup -->
<style>
    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8); /* Dark overlay */
        display: flex;
        justify-content: center;
        align-items: center; /* Center vertically */
        z-index: 1000;
        overflow: hidden; /* Prevent scrolling of background */
    }

    .popup-content {
        background: white;
        padding: 20px;
        border-radius: 8px;
        width: 80%;
        max-width: 600px;
        position: relative;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        text-align: left; /* Align text to the left */
        max-height: 80vh; /* Maximum height of the popup */
        overflow-y: auto; /* Scroll if content overflows */
    }

    .popup-close {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 18px;
        color: #000;
        background: #f0f0f0;
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 10px 20px;
        cursor: pointer;
        text-align: center;
        font-weight: bold;
    }

    /* Style for clickable text in label */
    .popup-link {
        color: yellow; /* Yellow color for visibility */
        cursor: pointer;
        text-decoration: underline;
    }
</style>
