    @* Phone Number "Only Numbers Input" Script *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var phoneInputs = ["#director-phone", "#producer-phone", "#applicant-phone"];

            // Function to validate phone number input
            function validatePhoneNumber(inputElement) {
                const phoneNumberPattern = /^[0-9 ]*$/; // Regex to allow only numbers and spaces

                // Create or select the error message element for the specific input field
                let errorMessageElement = inputElement.parentElement.querySelector(".phone-error");
                if (!errorMessageElement) {
                    errorMessageElement = document.createElement("span");
                    errorMessageElement.classList.add("text-danger", "phone-error");
                    errorMessageElement.style.display = "block";
                    inputElement.parentElement.appendChild(errorMessageElement);
                }

                // Remove previous border classes
                inputElement.classList.remove("border-success", "border-danger");

                if (inputElement.value.trim() === "") {
                    // If input is empty, apply error styles and show error
                    inputElement.classList.add("border-danger");
                    errorMessageElement.textContent = "Phone number cannot be empty";
                    errorMessageElement.style.display = "block";
                    inputElement.setCustomValidity("Phone number cannot be empty");
                } else if (!phoneNumberPattern.test(inputElement.value.trim())) {
                    // If input contains non-numeric characters, apply error styles and show error
                    inputElement.classList.add("border-danger");
                    errorMessageElement.textContent = "Please enter only numbers and spaces";
                    errorMessageElement.style.display = "block";
                    inputElement.setCustomValidity("Please enter only numbers and spaces");
                } else {
                    // If input is valid, apply success styles and hide the error
