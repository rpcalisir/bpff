            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="DirectorFilmographyTr" class="form-label" asp-for="DirectorFilmographyTr">Filmography TR</label>
                    <textarea class="form-control" asp-for="DirectorFilmographyTr" id="DirectorFilmographyTr" rows="10" maxlength="1000" style="resize: none;"></textarea>
                    <div class="form-text"><span id="charCountDirectorFilmographyTr">1000</span> characters remaining</div>
