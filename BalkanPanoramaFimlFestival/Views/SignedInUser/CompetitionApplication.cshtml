    @* MovieSubtitle Optional Checkbox Handle Script *@
    @* MovieSubtitle Optional Checkbox Handle Script *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const uploadedMovieSubtitleInput = document.getElementById('UploadedMovieSubtitle');
            const movieSubtitleOptionalCheckbox = document.getElementById('MovieSubtitleOptional');
            const subtitleErrorMessages = document.getElementById('subtitleErrorMessages');
            const container = document.getElementById('media-container');

            const maxSizeInMB = 2;
            const maxSizeInBytes = maxSizeInMB * 1024 * 1024;
            const maxFiles = 1;

            function validateMovieSubtitleUpload() {
                const files = uploadedMovieSubtitleInput.files;
                let errorMessages = [];
                let totalSize = 0;

                if (movieSubtitleOptionalCheckbox.checked) {
                    // Checkbox is checked, disable file input, clear files, and clear errors
                    uploadedMovieSubtitleInput.disabled = true;
                    uploadedMovieSubtitleInput.value = ''; // Clear the file input
                    subtitleErrorMessages.textContent = '';
                    uploadedMovieSubtitleInput.style.borderColor = 'green'; // Set border color to green
                    return true;
                } else {
                    // Enable file input if checkbox is not checked
                    uploadedMovieSubtitleInput.disabled = false;
                }

                // Validate files
                if (files.length === 0) {
                    errorMessages.push('A subtitle file must be uploaded.');
                } else if (files.length > maxFiles) {
                    errorMessages.push(`You can upload a maximum of ${maxFiles} subtitle file.`);
                } else {
                    // Calculate total size of uploaded files
                    for (let i = 0; i < files.length; i++) {
                        totalSize += files[i].size;
                    }

                    if (totalSize > maxSizeInBytes) {
                        errorMessages.push(`The total size of the uploaded subtitle file must be less than ${maxSizeInMB} MB.`);
                    }
                }

                // Update border color and error messages
                if (errorMessages.length > 0) {
                    subtitleErrorMessages.textContent = errorMessages.join(' ');
                    uploadedMovieSubtitleInput.style.borderColor = 'red'; // Set border color to red on error
                } else {
                    subtitleErrorMessages.textContent = '';
                    uploadedMovieSubtitleInput.style.borderColor = 'green'; // Set border color to green if no error
                }
            }

            // Attach event listeners
            movieSubtitleOptionalCheckbox.addEventListener('change', validateMovieSubtitleUpload);
            uploadedMovieSubtitleInput.addEventListener('change', validateMovieSubtitleUpload);

            // Validate on form submission
            document.querySelector('form').addEventListener('submit', function (event) {
                const files = uploadedMovieSubtitleInput.files;
                if (!movieSubtitleOptionalCheckbox.checked && (files.length === 0 || files.length > 1)) {
                    validateMovieSubtitleUpload();
                    event.preventDefault(); // Prevent form submission if validation fails
                    uploadedMovieSubtitleInput.focus(); // Add focus to the file input
                }
            });
        });
    </script>

