                <div class="col-md-6">
                    <label for="ProducerWebsite" class="form-label" asp-for="ProducerWebsite">Producer Website(Optional)</label>
                    <input class="form-control" asp-for="ProducerWebsite"
                           id="ProducerWebsite" name="ProducerWebsite"
                           maxlength="100" placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="ProducerWebsite"></span>
                </div>
            </div>
        </div>

        @* <-- --> *@

        <div class="row">
            <div class="col-md-10 offset-md-1 text-start">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </div>
    </form>
</div>
