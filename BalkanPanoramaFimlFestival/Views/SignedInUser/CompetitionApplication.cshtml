<h1 class="text-center mb-5">COMPETITION APPLICATION</h1>

<div class="container">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-info" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @* General errors related to application (comes from ModelState) for client side validation in the form *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    @* If there is no enctype="multipart/form-data" attribute, then UploadedPdfFile is null *@
    <form asp-controller="SignedInUser" asp-action="CompetitionApplication" method="post" enctype="multipart/form-data">

        @* <-- CATEGORY --> *@

        <b2 class="col-md-10 offset-md-1"><strong>CHOOSE COMPETITION CATEGORY</strong></b2>

        <div id="movie-category-container" class="row mb-3">
            <div class="col-md-10 offset-md-1">
                <div class="form-check form-check-inline">
                    <input type="radio" asp-for="CompetitionCategory" value="Option1" class="form-check-input" id="option1" />
                    <label class="form-check-label" for="option1">SARI ŞEMSİYE ULUSAL UZUN METRAJ FİLM YARIŞMASI</label>
                </div>

                <div class="form-check form-check-inline mx-3">
                    <input type="radio" asp-for="CompetitionCategory" value="Option2" class="form-check-input" id="option2" />
                    <label class="form-check-label" for="option2">SARI ŞEMSİYE ULUSAL KISA METRAJ FİLM YARIŞMASI</label>
                </div>

                <div class="form-check form-check-inline">
                    <input type="radio" asp-for="CompetitionCategory" value="Option3" class="form-check-input" id="option3" />
                    <label class="form-check-label" for="option3">DARIO MORENO</label>
                </div>

                @* Display validation errors for the specific field *@
                @* Errors comes from model *@
                <div class="text-danger mb-3">
                    <span asp-validation-for="CompetitionCategory"></span>
                </div>
            </div>
        </div>

        @* <-- GENERAL INFORMATION --> *@

        <b2 class="col-md-10 offset-md-1"><strong>GENERAL INFORMATION</strong></b2>

        <div id="general-info-container" class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="OriginalMovieName" class="form-label" asp-for="OriginalMovieName">Original Movie Name</label>
                    <input value="Original Movie Name" class="form-control" asp-for="OriginalMovieName"
                           id="OriginalMovieName" name="OriginalMovieName"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="OriginalMovieName"></span>
                </div>

                <div class="col-md-6">
                    <label for="EnglishMovieName" class="form-label" asp-for="EnglishMovieName">English Movie Name</label>
                    <input value="English Movie Name" class="form-control" asp-for="EnglishMovieName"
                           id="EnglishMovieName" name="EnglishMovieName"
                           maxlength="100" required placeholder="Max 100 characters">
                    <span class="text-danger" asp-validation-for="EnglishMovieName"></span>
                </div>
            </div>

            <div class="row mb-3 col-md-12">
                <div class="col-md-12">
                    <label for="MovieWebsite" class="form-label" asp-for="MovieWebsite">Movie Website (Optional)</label>
                    <input class="form-control" asp-for="MovieWebsite"
                           id="MovieWebsite" name="MovieWebsite"
                           maxlength="100" placeholder="Max 100 characters">
                    <span class="text-danger" asp-validation-for="MovieWebsite"></span>
                </div>
            </div>
        </div>

        @* <-- COUNTRIES --> *@

        <b2 class="col-md-10 offset-md-1"><strong>SELECT COUNTRIES(MAX 5)</strong></b2>

        <div class="row mb-3">
            <div class="col-md-10 offset-md-1">
                <div id="countries-container" class="border border-secondary rounded p-3">
                    <div class="d-flex flex-wrap">
                        @for (int i = 0; i < Model.AllCountries.Count; i++)
                        {
                            <div class="col-md-4 col-lg-3 mb-3">
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="country-@i"
                                           name="SelectedCountries"
                                           value="@Model.AllCountries[i]"
                                    @* This makes it possible to preserve previous selection after page reload in case form is invalid *@
                                    @(Model.SelectedCountries.Contains(Model.AllCountries[i]) ? "checked" : "") />
                                    <label class="form-check-label" for="country-@i">@Model.AllCountries[i]</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @* error comes from JS script, generates error for client side validation *@
                <span class="text-danger" id="validation-message-country"></span>
            </div>
        </div>

        @* <-- GENRES --> *@

        <b2 class="col-md-10 offset-md-1"><strong>MOVIE GENRES(MAX 3)</strong></b2>

        <div class="row mb-3">
            <div class="col-md-10 offset-md-1">
                <div id="movie-genres-container" class="border border-secondary rounded p-3">
                    <div class="d-flex flex-wrap">
                        @for (int i = 0; i < Model.AllMovieGenres.Count; i++)
                        {
                            <div class="col-md-4 col-lg-3 mb-3">
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="genre-@i"
                                           name="SelectedMovieGenres"
                                           value="@Model.AllMovieGenres[i]"
                                    @* This makes it possible to preserve previous selection after page reload in case form is invalid *@
                                    @(Model.SelectedMovieGenres.Contains(Model.AllMovieGenres[i]) ? "checked" : "") />
                                    <label class="form-check-label" for="genre-@i">@Model.AllMovieGenres[i]</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @* error comes from JS script, generates error for client side validation *@
                <span class="text-danger" id="validation-message-genre"></span>
            </div>
        </div>

        @* <-- MOVIE FEATURES --> *@

        <b2 class="col-md-10 offset-md-1"><strong>MOVIE FEATURES</strong></b2>

        <div id="movie-features-container" class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="col-md-4">
                <label for="ProductionYear" class="form-label" asp-for="ProductionYear">Production Year</label>
                <select class="form-control" id="ProductionYear" name="ProductionYear" required>
                    <option value="">Select Production Year</option>
                    <option value="2022">2022</option>
                    <option value="2023">2023</option>
                    <option value="2024">2024</option>
                </select>
                <div class="form-text"></div>
                <span class="text-danger" id="ProductionYearError" asp-validation-for="ProductionYear"></span>
            </div>

            <div class="col-md-4">
                <label for="MovieTimeLength" class="form-label">Time Length(Select Category First)</label>
                <select class="form-control" id="MovieTimeLength" name="MovieTimeLength" required>
                    <!-- Options will be populated by JavaScript -->
                </select>
                <div class="text-danger" id="MovieTimeLengthError"></div> <!-- To show validation message -->
            </div>
            <div class="col-md-4">
                <label for="MovieLanguage" class="form-label" asp-for="MovieLanguage">Movie Language</label>
                <select id="LanguageSelectMovie" name="MovieLanguage" class="form-control" required>
                    <option value="">Select Movie Language</option>
                    <!-- Populate countries here -->
                </select>
                <input type="hidden" id="MovieLanguageName" name="MovieLanguageName" />
                <span id="LanguageErrorMovie" class="text-danger" style="display: none;">Please select a language.</span>
            </div>
        </div>

