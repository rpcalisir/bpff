    <script>
            function validateGeneralInfo() {
                var generalInfoContainer = document.getElementById('general-info-container');
                var requiredInputs = generalInfoContainer.querySelectorAll('input[required]');
                var allValid = true;

                // Check each required input
                requiredInputs.forEach(function (input) {
                    if (!input.value.trim()) {
                        allValid = false;
                        input.classList.add('border-danger');
                        input.classList.remove('border-success');
                    } else {
                        input.classList.add('border-success');
                        input.classList.remove('border-danger');
                    }
                });

                // Update container border color based on the validity of inputs
                if (allValid) {
                    generalInfoContainer.classList.add('border-success');
                    generalInfoContainer.classList.remove('border-danger');
                } else {
                    generalInfoContainer.classList.add('border-danger');
                    generalInfoContainer.classList.remove('border-success');
                }

                return allValid; // Return whether the general info is valid
            }

        // Attach the validation function to the form submit event
        document.querySelector('form').addEventListener('submit', function (event) {
            if (!validateGeneralInfo()) {
                event.preventDefault(); // Prevent form submission if there are errors
            }
        });

        // Attach the validation function to each required input's input event
        document.querySelectorAll('#general-info-container input[required]').forEach(function (input) {
            input.addEventListener('input', validateGeneralInfo);
        });
    </script>

