            <label for="applicantSameAsDirector" class="form-check-label">Copy from Director</label>
            <input type="checkbox" id="applicantSameAsProducer" class="form-check-input ms-2">
            <label for="applicantSameAsProducer" class="form-check-label">Copy from Producer</label>

            <!-- Aligning the error message div with the other form elements -->
            <div class="row mb-3 col-md-10 offset-md-1">
                <div class="col-md-12">
                    <!-- Error message placeholder -->
                    <div id="applicantSameAsDirectorError" class="text-danger" style="display: none;">
                        <!-- Error message will be dynamically set by the script -->
                    </div>
                </div>
            </div>
            @* applicantSameAsCheckboxError *@
            <!-- Aligning the error message div with the other form elements -->
            <div class="row mb-3 col-md-10 offset-md-1">
                <div class="col-md-12">
                    <!-- Error message placeholder -->
                    <div id="applicantSameAsProducerError" class="text-danger" style="display: none;">
                        <!-- Error message will be dynamically set by the script -->
                    </div>
                </div>
            </div>
        </b2>

        <div id="applicant-container" class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="row mb-3 col-md-12">
                <div class="col-md-12">
                    <label for="ApplicantName" class="form-label" asp-for="ApplicantName">Applicant Name</label>
                    <input class="form-control" asp-for="ApplicantName"
                           id="ApplicantName" name="ApplicantName"
                           maxlength="100" required placeholder="Max 100 characters"
                           data-val-required="The Applicant Name is required">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="ApplicantName"></span>
                </div>
            </div>

            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="ApplicantCompany" class="form-label" asp-for="ApplicantCompany">Applicant Company</label>
                    <input class="form-control" asp-for="ApplicantCompany"
                           id="ApplicantCompany" name="ApplicantCompany"
                           maxlength="100" required placeholder="Max 100 characters"
                           data-val-required="The Applicant Company is required">
                    <span class="text-danger" asp-validation-for="ApplicantCompany"></span>
                </div>
                <div class="col-md-6">
                    <label for="ApplicantEmail" class="form-label" asp-for="ApplicantEmail">Applicant Email Address</label>
                    <input class="form-control" asp-for="ApplicantEmail"
                           id="ApplicantEmail" name="ApplicantEmail"
                           maxlength="100" required placeholder="Max 100 characters"
                           data-val-required="The Applicant Email is required">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="ApplicantEmail"></span>
                </div>
            </div>
            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="ApplicantPhone" class="col-md-4 col-form-label" asp-for="ApplicantPhone">Applicant Phone</label>

                    <div class="input-group">
                        <input id="applicant-phone" type="tel" asp-for="ApplicantPhone" class="form-control"
                               name="ApplicantPhone"
                               maxlength="25" required placeholder="Max 25 characters"
                               data-val-required="The Applicant Phone is required">
                    </div>
                    <span class="text-danger" asp-validation-for="ApplicantPhone"></span>
                </div>
                <div class="col-md-6">
                    <label for="ApplicantCountry" class="form-label" asp-for="ApplicantCountry">Applicant Country</label>
                    <select id="CountrySelectApplicant" name="ApplicantCountry" class="form-control" required>
                        <option value="">Select Country</option>
                        <!-- Populate countries here -->
                    </select>
                    <input type="hidden" id="ApplicantCountryName" name="ApplicantCountryName"
                           data-val-required="The Applicant Country is required" />
                    <span id="CountryErrorApplicant" class="text-danger" style="display: none;">Please select a country.</span>
                </div>
            </div>
        </div>
        @* <-- --> *@

        @* <-- IMPORTANT NOTE --> *@
        <div class="col-md-10 offset-md-1 mt-3">
            <strong>IMPORTANT NOTE:</strong>
        </div>

        <div class="row mb-3 col-md-10 offset-md-1 mt-3">
            <p class="col-md-12">
                All fields in the Application Form must be filled in, please read carefully and fill in.<br><br>

                - Feature Film Competition: Fiction, animation and documentary films of 60 minutes and above can apply.<br>
                - Short Film Competition: Fiction, animation and documentary films of at least 5 minutes and at most 25 minutes including the credits can apply.<br>
                - English subtitles are required for the film that is eligible to enter the competition. Therefore, films without English subtitles will not be accepted to the competition.<br>
                - Director Biography and Filmography must be written in Turkish and English. Applications written in a single language will be considered invalid.<br>
                - Synopsis must be written in Turkish and English. Only films in MP4 and MKV format will be accepted. All other formats are invalid.<br>
                - See the General Rules for technical details. If your application is not selected for the competition by the Preliminary Jury, you will be deemed to have accepted that your film will be shown in the non-competition program, at most 3 (three) times during the festival, if deemed appropriate.<br>
                - Downloadable Screening Copy of the Film MP4 and MKV copies that comply with the technical specifications in the General Rules must have a working download link for at least 7 (seven) days.<br><br>

                Deadline: September 18, 2024<br><br>

                If you have any questions, we will be happy to help you. Please contact us at info@bff.art.
            </p>
        </div>
        @* <-- --> *@

        @* I HAVE READ AND APPROVE *@
        <div class="row mb-3 col-md-10 offset-md-1">
            <div class="form-check">
                <input type="checkbox" id="approveCheckbox" class="form-check-input">
                <label for="approveCheckbox" class="form-check-label">I HAVE READ AND APPROVE</label>
            </div>
            <div id="approveError" class="text-danger" style="display: none;">
                You must approve the terms before submitting.
            </div>
        </div>
        @* <-- --> *@

        @* I HAVE READ THE GENERAL RULES AND APPROVE THEM *@
        <div class="row mb-3 col-md-10 offset-md-1">
            <div class="form-check">
                <input type="checkbox" id="generalRulesCheckbox" class="form-check-input">
                <label for="generalRulesCheckbox" class="form-check-label">
                    I HAVE READ THE <a href="#" id="generalRulesLink" style="color: yellow;">GENERAL RULES</a> AND APPROVE THEM
                </label>
            </div>
            <div id="generalRulesError" class="text-danger" style="display: none;">
                You must approve the General Rules before submitting.
            </div>
        </div>

        <!-- General Rules Popup -->
        <div id="generalRulesPopup" class="popup-overlay" style="display: none;">
            <div class="popup-content">
                <span id="popupClose" class="popup-close">CLOSE</span>
                <h2>GENERAL RULES</h2>
                <p>
                    Feature Length Film Competition<br><br>

                    1. The length of the film must be at least 60 minutes.<br>
                    2. Fiction, animation, and documentary films can apply.<br>
                    3. Only MP4 and MKV formats are accepted.<br>
                    4. Films produced in January 2022 and later can apply.<br>
                    5. Films that apply must not have been screened in Izmir.<br><br>

                    Short Length Film Competition<br><br>

                    1. The length of the film, including the credits, must be at least 5 minutes and at most 25 minutes.<br>
                    2. Fiction, animation, and documentary films can apply.<br>
                    3. Only MP4 and MKV formats are accepted.<br>
                    4. Films produced in January 2022 and later can apply.<br>
                    5. Films that apply must not have been screened in Izmir.<br><br>

                    Feature Lenght Film Screening<br><br>

                    1. The length of the film must be at least 60 minutes.<br>
                    2. Fiction, animation, and documentary films can apply.<br>
                    3. Only MP4 and MKV formats are accepted.<br>
                    4. Films produced in January 2022 and later can apply.<br>
                    5. The films that apply must not have been shown in Izmir.<br><br>

                    Short Length Film Screening<br><br>

                    1. The length of the film, including the credits, must be at least 5 minutes and at most 25 minutes.<br>
                    2. Fiction, animation, and documentary films can apply.<br>
                    3. Only MP4 and MKV formats are accepted.<br>
                    4. Films produced in January 2022 and later can apply.<br>
                    5. The films that apply must not have been shown in Izmir.<br><br>

                    Competition and screening applications will only be accepted from the following countries:<br><br>

                    Albania, Austria, Bosnia and Herzegovina, Bulgaria, Croatia, Italy, Montenegro, Kosovo, North Macedonia, Hungary, Moldova, Romania, Serbia, Slovenia, Turkey, and Greece.<br><br>

                    NOTE: The country names are listed in alphabetical order.<br><br>

                    MP4 and MKV Copy Specifications:<br>
                    * Bit Rate: Minimum 25 Mbps, maximum 35 Mbps<br>
                    * Bit Rate Mode: Constant Bitrate (CBR)<br>
                    * Video Format: AVC/Advanced Video Codec (H.264 or H.265)<br>
                    * Width: 1920 pixels<br>
                    * Height: 1080 pixels<br>
                    * Display Aspect Ratio: 16:9<br>
                    * Frame Rate Mode: Constant<br>
                    * Scan Type: Progressive<br>
                    * Audio Format: Minimum Advanced Audio Codec (AAC)<br>
                    * Minimum Bit Rate: 320 kbps<br>
                    * Channels: Minimum 2 channels<br>
                    * Sampling Rate Rate: 48.0 kHz<br>
                    * Subtitles: SRT format, UTF-8 encoding<br><br>

                    IMPORTANT: The download link and password of the movie, if any, are valid for at least 30 (thirty) days from the date of sending.<br><br>

                    If you have any questions, we will be happy to help you. Please contact us at info@bpff.com.tr.
                </p>
            </div>
        </div>
        @* <-- --> *@

        @* REGULATIONS *@
        <div class="row mb-3 col-md-10 offset-md-1">
            <div class="form-check">
                <input type="checkbox" id="regulationsCheckbox" class="form-check-input">
                <label for="regulationsCheckbox" class="form-check-label">
                    I HAVE READ THE <span id="regulationsLink" class="popup-link">REGULATIONS</span> AND APPROVE THEM
                </label>
            </div>
            <div id="regulationsError" class="text-danger" style="display: none;">
                You must approve the Regulations before submitting.
            </div>
        </div>

        <!-- Regulations Popup -->
        <div id="regulationsPopup" class="popup-overlay" style="display: none;">
            <div class="popup-content">
                <span id="regulationsPopupClose" class="popup-close">CLOSE</span>
                <h2>REGULATIONS</h2>
                <p>
                    A) PURPOSE

                    To promote, support and establish a joint fund for collaboration among filmmakers in the Balkan countries within the scope of the Balkan Panorama Film Festival, which aims to promote and support important and innovative works of Turkish and Balkan cinema and to make Izmir a meeting point between filmmakers and audiences.
                </p>
            </div>
        </div>
        @* <-- --> *@

        <!-- Submit Button -->
        <div class="row">
            <div class="col-md-10 offset-md-1 text-start">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </div>
    </form>
</div>


