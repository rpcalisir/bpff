            const optCbUploadedBestActressPhoto = document.getElementById('optCbUploadedBestActressPhoto');
            const UploadedBestActressPhotoMessages = document.getElementById('UploadedBestActressPhotoMessages');

            const maxSizeInMB = 3;
            const maxSizeInBytes = maxSizeInMB * 1024 * 1024;

            function validateUploadedBestActressPhoto() {
                const files = UploadedBestActressPhotoInput.files;
                let errorMessages = [];
                let totalSize = 0;

                if (optCbUploadedBestActressPhoto.checked) {
                    // Checkbox is checked, disable inputs, clear files, clear name, and clear errors
                    UploadedBestActressPhotoInput.disabled = true;
                    bestActressNameInput.disabled = true;
                    UploadedBestActressPhotoInput.value = '';
                    bestActressNameInput.value = '';
                    UploadedBestActressPhotoMessages.textContent = '';
                    UploadedBestActressPhotoInput.style.borderColor = 'green';
                    bestActressNameInput.style.borderColor = 'green';
                    return true;
                } else {
                    // Enable inputs if checkbox is not checked
                    UploadedBestActressPhotoInput.disabled = false;
                    bestActressNameInput.disabled = false;
                }

                // Validate file input
                if (files.length === 0) {
                    UploadedBestActressPhotoInput.style.borderColor = 'red';
                    errorMessages.push('Best Actress photo must be uploaded.');
                } else if (files.length > 1) {
                    UploadedBestActressPhotoInput.style.borderColor = 'red';
                    errorMessages.push('You can upload only 1 photo.');
                } else {
                    totalSize = files[0].size;
                    if (totalSize > maxSizeInBytes) {
                        UploadedBestActressPhotoInput.style.borderColor = 'red';
                        errorMessages.push(`The photo size must be less than ${maxSizeInMB} MB.`);
                    } else {
                        UploadedBestActressPhotoInput.style.borderColor = 'green';
                    }
                }

                // Validate name input
                if (bestActressNameInput.value.trim() === '') {
                    bestActressNameInput.style.borderColor = 'red';
                    errorMessages.push('Actress name must be provided.');
                } else if (bestActressNameInput.value.length > 100) {
                    bestActressNameInput.style.borderColor = 'red';
                    errorMessages.push('Actress name cannot exceed 100 characters.');
                } else {
                    bestActressNameInput.style.borderColor = 'green';
                }

                // Update error messages
                if (errorMessages.length > 0) {
                    UploadedBestActressPhotoMessages.textContent = errorMessages.join(' ');
                } else {
                    UploadedBestActressPhotoMessages.textContent = '';
                }

                // Focus on the first invalid field
                if (errorMessages.length > 0) {
                    if (UploadedBestActressPhotoInput.style.borderColor === 'red') {
                        UploadedBestActressPhotoInput.focus();
                    } else if (bestActressNameInput.style.borderColor === 'red') {
                        bestActressNameInput.focus();
                    }
                }
            }

            // Attach event listeners
            optCbUploadedBestActressPhoto.addEventListener('change', validateUploadedBestActressPhoto);
            UploadedBestActressPhotoInput.addEventListener('change', validateUploadedBestActressPhoto);
            bestActressNameInput.addEventListener('input', validateUploadedBestActressPhoto);

            // Validate on form submission
            document.querySelector('form').addEventListener('submit', function (event) {
                const files = UploadedBestActressPhotoInput.files;
                if (!optCbUploadedBestActressPhoto.checked && (files.length === 0 || files.length > 1 || bestActressNameInput.value.trim() === '' || bestActressNameInput.value.length > 100)) {
