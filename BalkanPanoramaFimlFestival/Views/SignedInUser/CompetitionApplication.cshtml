                    element.classList.add('border-danger');
                    element.classList.remove('border-success');
                } else {
                    element.classList.add('border-success');
                    element.classList.remove('border-danger');
                }
            });

            // Validate country selection separately
            var directorCountry = document.getElementById('CountrySelectDirector');
            var countryError = document.getElementById('CountryErrorDirector');
            if (directorCountry && directorCountry.value === "") {
                allValid = false;
                directorCountry.classList.add('border-danger');
                directorCountry.classList.remove('border-success');
                countryError.style.display = "block";
            } else if (directorCountry) {
                directorCountry.classList.add('border-success');
                directorCountry.classList.remove('border-danger');
                countryError.style.display = "none";
            }

            // Ensure container border color updates based on the validity of all required fields
            if (allValid) {
                directorContainer.classList.add('border-success');
                directorContainer.classList.remove('border-danger');
            } else {
                directorContainer.classList.add('border-danger');
                directorContainer.classList.remove('border-success');
            }

            return allValid; // Return whether the director info is valid
        }

        // Attach the validation function to the form submit event
        document.querySelector('form').addEventListener('submit', function (event) {
            if (!validateDirectorInfo()) {
                event.preventDefault(); // Prevent form submission if there are errors
            }
        });

        // Attach the validation function to each required input's input/change event
        document.querySelectorAll('#director-container input[required], #director-container select[required], #director-container textarea[required]').forEach(function (element) {
