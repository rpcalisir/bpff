<h1 class="text-center mb-5">COMPETITION APPLICATION</h1>

<div class="container">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-info" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @* General errors related to application (comes from ModelState) for client side validation in the form *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    @* If there is no enctype="multipart/form-data" attribute, then UploadedPdfFile is null *@
    <form asp-controller="SignedInUser" asp-action="CompetitionApplication" method="post" enctype="multipart/form-data">

        @* <-- CATEGORY --> *@

        <b2 class="col-md-10 offset-md-1"><strong>CHOOSE COMPETITION CATEGORY</strong></b2>

        <div id="movie-category-container" class="row mb-3">
            <div class="col-md-10 offset-md-1">
                <div class="form-check form-check-inline">
                    <input type="radio" asp-for="CompetitionCategory" value="Option1" class="form-check-input" id="option1" />
                    <label class="form-check-label" for="option1">SARI ŞEMSİYE ULUSAL UZUN METRAJ FİLM YARIŞMASI</label>
                </div>

                <div class="form-check form-check-inline mx-3">
                    <input type="radio" asp-for="CompetitionCategory" value="Option2" class="form-check-input" id="option2" />
                    <label class="form-check-label" for="option2">SARI ŞEMSİYE ULUSAL KISA METRAJ FİLM YARIŞMASI</label>
                </div>

                <div class="form-check form-check-inline">
                    <input type="radio" asp-for="CompetitionCategory" value="Option3" class="form-check-input" id="option3" />
                    <label class="form-check-label" for="option3">DARIO MORENO</label>
                </div>

                @* Display validation errors for the specific field *@
                @* Errors comes from model *@
                <div class="text-danger mb-3">
                    <span asp-validation-for="CompetitionCategory"></span>
                </div>
            </div>
        </div>

        @* <-- GENERAL INFORMATION --> *@

        <b2 class="col-md-10 offset-md-1"><strong>GENERAL INFORMATION</strong></b2>

        <div id="general-info-container" class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="OriginalMovieName" class="form-label" asp-for="OriginalMovieName">Original Movie Name</label>
                    <input class="form-control" asp-for="OriginalMovieName"
                           id="OriginalMovieName" name="OriginalMovieName"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="OriginalMovieName"></span>
                </div>

                <div class="col-md-6">
                    <label for="EnglishMovieName" class="form-label" asp-for="EnglishMovieName">English Movie Name</label>
                    <input class="form-control" asp-for="EnglishMovieName"
                           id="EnglishMovieName" name="EnglishMovieName"
                           maxlength="100" required placeholder="Max 100 characters">
                    <span class="text-danger" asp-validation-for="EnglishMovieName"></span>
                </div>
            </div>

            <div class="row mb-3 col-md-12">
                <div class="col-md-12">
                    <label for="MovieWebsite" class="form-label" asp-for="MovieWebsite">Movie Website (Optional)</label>
                    <input class="form-control" asp-for="MovieWebsite"
                           id="MovieWebsite" name="MovieWebsite"
                           maxlength="100" placeholder="Max 100 characters">
                    <span class="text-danger" asp-validation-for="MovieWebsite"></span>
                </div>
            </div>
        </div>

        @* <-- COUNTRIES --> *@

        <b2 class="col-md-10 offset-md-1"><strong>SELECT COUNTRIES(MAX 5)</strong></b2>

        <div class="row mb-3">
            <div class="col-md-10 offset-md-1">
                <div id="countries-container" class="border border-secondary rounded p-3">
                    <div class="d-flex flex-wrap">
                        @for (int i = 0; i < Model.AllCountries.Count; i++)
                        {
                            <div class="col-md-4 col-lg-3 mb-3">
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="country-@i"
                                           name="SelectedCountries"
                                           value="@Model.AllCountries[i]"
                                    @* This makes it possible to preserve previous selection after page reload in case form is invalid *@
                                    @(Model.SelectedCountries.Contains(Model.AllCountries[i]) ? "checked" : "") />
                                    <label class="form-check-label" for="country-@i">@Model.AllCountries[i]</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @* error comes from JS script, generates error for client side validation *@
                <span class="text-danger" id="validation-message-country"></span>
            </div>
        </div>

        @* <-- GENRES --> *@

        <b2 class="col-md-10 offset-md-1"><strong>MOVIE GENRES(MAX 3)</strong></b2>

        <div class="row mb-3">
            <div class="col-md-10 offset-md-1">
                <div id="movie-genres-container" class="border border-secondary rounded p-3">
                    <div class="d-flex flex-wrap">
                        @for (int i = 0; i < Model.AllMovieGenres.Count; i++)
                        {
                            <div class="col-md-4 col-lg-3 mb-3">
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="genre-@i"
                                           name="SelectedMovieGenres"
                                           value="@Model.AllMovieGenres[i]"
                                    @* This makes it possible to preserve previous selection after page reload in case form is invalid *@
                                    @(Model.SelectedMovieGenres.Contains(Model.AllMovieGenres[i]) ? "checked" : "") />
                                    <label class="form-check-label" for="genre-@i">@Model.AllMovieGenres[i]</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @* error comes from JS script, generates error for client side validation *@
                <span class="text-danger" id="validation-message-genre"></span>
            </div>
        </div>

        @* <-- MOVIE FEATURES --> *@

        <b2 class="col-md-10 offset-md-1"><strong>MOVIE FEATURES</strong></b2>

        <div id="movie-features-container" class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="col-md-4">
                <label for="ProductionYear" class="form-label" asp-for="ProductionYear">Production Year</label>
                <select class="form-control" id="ProductionYear" name="ProductionYear" required>
                    <option value="">Select Production Year</option>
                    <option value="2022">2022</option>
                    <option value="2023">2023</option>
                    <option value="2024">2024</option>
                </select>
                <div class="form-text"></div>
                <span class="text-danger" id="ProductionYearError" asp-validation-for="ProductionYear"></span>
            </div>

            <div class="col-md-4">
                <label for="MovieTimeLength" class="form-label">Time Length(Select Category First)</label>
                <select class="form-control" id="MovieTimeLength" name="MovieTimeLength" required>
                    <!-- Options will be populated by JavaScript -->
                </select>
                <div class="text-danger" id="MovieTimeLengthError"></div> <!-- To show validation message -->
            </div>
            <div class="col-md-4">
                <label for="MovieLanguage" class="form-label" asp-for="MovieLanguage">Movie Language</label>
                <select id="LanguageSelectMovie" name="MovieLanguage" class="form-control" required>
                    <option value="">Select Movie Language</option>
                    <!-- Populate countries here -->
                </select>
                <input type="hidden" id="MovieLanguageName" name="MovieLanguageName" />
                <span id="LanguageErrorMovie" class="text-danger" style="display: none;">Please select a language.</span>
            </div>
        </div>

        @* <-- DIRECTOR --> *@
        <b2 class="col-md-10 offset-md-1"><strong>DIRECTOR</strong></b2>

        <div id="director-container" class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="DirectorName" class="form-label" asp-for="DirectorName">Director Name</label>
                    <input value="Director Name" class="form-control" asp-for="DirectorName"
                           id="DirectorName" name="DirectorName"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="DirectorName"></span>
                </div>
                <div class="col-md-6">
                    <label for="DirectorEmail" class="form-label" asp-for="DirectorEmail">Director Email Address</label>
                    <input value="Director Email Address" class="form-control" asp-for="DirectorEmail"
                           id="DirectorEmail" name="DirectorEmail"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="DirectorEmail"></span>
                </div>
            </div>

            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="DirectorPhone" class="col-md-4 col-form-label" asp-for="DirectorPhone">Director Phone</label>

                    <div class="input-group">
                        @* id attribute makes it possible to run phone scripts, it must be unique *@
                        @* type="tel" attribute makes it possible to enter only numbers *@
                        <input value="0542 123 45 78" id="director-phone" type="tel" asp-for="DirectorPhone" class="form-control"
                               name="DirectorPhone"
                               maxlength="25" required placeholder="Max 25 characters">
                    </div>
                    <span class="text-danger" asp-validation-for="DirectorPhone"></span>
                </div>
                <div class="col-md-6">
                    <label for="DirectorCountry" class="form-label" asp-for="DirectorCountry">Director Country</label>
                    <select id="CountrySelectDirector" name="DirectorCountry" class="form-control" required>
                        <option value="">Select Country</option>
                        <!-- Populate countries here -->
                    </select>
                    <input type="hidden" id="DirectorCountryName" name="DirectorCountryName" />
                    <span id="CountryErrorDirector" class="text-danger" style="display: none;">Please select a country.</span>
                </div>
            </div>

            <div class="row mb-3 col-md-12">
                <!-- Director Biography TR -->
                <div class="col-md-6">
                    <label for="DirectorBiographyTr" class="form-label" asp-for="DirectorBiographyTr">Director Biography TR</label>
                    <textarea class="form-control" asp-for="DirectorBiographyTr" id="DirectorBiographyTr" rows="10" maxlength="1000" required style="resize: none;"></textarea>
                    <div class="form-text"><span id="charCountDirectorBiographyTr">1000</span> characters remaining</div>
                    <span class="text-danger" asp-validation-for="DirectorBiographyTr"></span>
                </div>

                <!-- Director Biography EN -->
                <div class="col-md-6">
                    <label for="DirectorBiographyEn" class="form-label" asp-for="DirectorBiographyEn">Director Biography EN</label>
                    <textarea class="form-control" asp-for="DirectorBiographyEn" id="DirectorBiographyEn" rows="10" maxlength="1000" required style="resize: none;"></textarea>
                    <div class="form-text"><span id="charCountDirectorBiographyEn">1000</span> characters remaining</div>
                    <span class="text-danger" asp-validation-for="DirectorBiographyEn"></span>
                </div>
            </div>

            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="DirectorFilmographyTr" class="form-label" asp-for="DirectorFilmographyTr">Filmography TR</label>
                    <textarea class="form-control" asp-for="DirectorFilmographyTr" id="DirectorFilmographyTr" rows="10" maxlength="1000" required style="resize: none;"></textarea>
                    <div class="form-text"><span id="charCountDirectorFilmographyTr">1000</span> characters remaining</div>
                    <span class="text-danger" asp-validation-for="DirectorFilmographyTr"></span>
                </div>

                <div class="col-md-6">
                    <label for="DirectorFilmographyEn" class="form-label" asp-for="DirectorFilmographyEn">Director Filmography En</label>
                    <textarea class="form-control" asp-for="DirectorFilmographyEn" id="DirectorFilmographyEn" rows="10" maxlength="1000" required style="resize: none;"></textarea>
                    <div class="form-text"><span id="charCountDirectorFilmographyEn">1000</span> characters remaining</div>
                    <span class="text-danger" asp-validation-for="DirectorFilmographyEn"></span>
                </div>
            </div>

        </div>

        @* <-- --> *@

        @* <-- MOVIE TAG --> *@

        <b2 class="col-md-10 offset-md-1"><strong>MOVIE TAG</strong></b2>

        <div id="movie-tag-container" class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="row mb-3 col-md-12 ">
                <div class="col-md-12">
                    <label for="MovieScript" class="form-label" asp-for="MovieScript">Movie Script</label>
                    <textarea class="form-control" asp-for="MovieScript" id="MovieScript" rows="10" maxlength="1000" required style="resize: none;"></textarea>
                    <div class="form-text"><span id="charCountMovieScript">1000</span> characters remaining</div>
                    <span class="text-danger" asp-validation-for="MovieScript"></span>
                </div>
            </div>
            <div class="row mb-3 col-md-12 ">
                <div class="col-md-12">
                    <label for="Cinematographer" class="form-label" asp-for="Cinematographer">Cinematographer</label>
                    <input value="Cinematographer" class="form-control" asp-for="Cinematographer"
                           id="Cinematographer" name="Cinematographer"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="Cinematographer"></span>
                </div>
            </div>
            <div class="row mb-3 col-md-12 ">
                <div class="col-md-12">
                    <label for="MovieFiction" class="form-label" asp-for="MovieFiction">Movie Fiction</label>
                    <textarea class="form-control" asp-for="MovieFiction" id="MovieFiction" rows="10" maxlength="1000" required style="resize: none;"></textarea>
                    <div class="form-text"><span id="charCountMovieFiction">1000</span> characters remaining</div>
                    <span class="text-danger" asp-validation-for="MovieFiction"></span>
                </div>
            </div>
            <div class="row mb-3 col-md-12 ">
                <div class="col-md-12">
                    <label for="MovieActors" class="form-label" asp-for="MovieActors">Movie Actors</label>
                    <textarea class="form-control" asp-for="MovieActors" id="MovieActors" rows="10" maxlength="1000" required style="resize: none;"></textarea>
                    <div class="form-text"><span id="charCountMovieActors">1000</span> characters remaining</div>
                    <span class="text-danger" asp-validation-for="MovieActors"></span>
                </div>
            </div>
            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="BestActress" class="form-label" asp-for="BestActress">Best Actress</label>
                    <input value="Best Actress" class="form-control" asp-for="BestActress"
                           id="BestActress" name="BestActress"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="BestActress"></span>
                </div>
                <div class="col-md-6">
                    <label for="BestActor" class="form-label" asp-for="BestActor">Best Actor</label>
                    <input value="Best Actor" class="form-control" asp-for="BestActor"
                           id="BestActor" name="BestActor"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="BestActor"></span>
                </div>
            </div>
        </div>

        @* <-- --> *@

        @* <-- PRODUCER --> *@
        <b2 class="col-md-10 offset-md-1"><strong>PRODUCER</strong></b2>

        <div id="producer-container" class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="row mb-3 col-md-12">
                <div class="col-md-12">
                    <label for="ProducerName" class="form-label" asp-for="ProducerName">Producer Name</label>
                    <input class="form-control" asp-for="ProducerName"
                           id="ProducerName" name="ProducerName"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="ProducerName"></span>
                </div>
            </div>

            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="ProducerCompany" class="form-label" asp-for="ProducerCompany">Producer Company</label>
                    <input class="form-control" asp-for="ProducerCompany"
                           id="ProducerCompany" name="ProducerCompany"
                           maxlength="100" required placeholder="Max 100 characters">
                    <span class="text-danger" asp-validation-for="ProducerCompany"></span>
                </div>
                <div class="col-md-6">
                    <label for="ProducerCountry" class="form-label" asp-for="ProducerCountry">Producer Country</label>
                    <select id="CountrySelectProducer" name="ProducerCountry" class="form-control" required>
                        <option value="">Select Country</option>
                        <!-- Populate countries here -->
                    </select>
                    <input type="hidden" id="ProducerCountryName" name="ProducerCountryName" />
                    <span id="CountryErrorProducer" class="text-danger" style="display: none;">Please select a country.</span>
                </div>
            </div>
            <div class="row mb-3 col-md-12">
                <div class="col-md-12">
                    <label for="ProducerPhone" class="col-md-4 col-form-label" asp-for="ProducerPhone">Producer Phone</label>

                    <div class="input-group">
                        <input id="producer-phone" type="tel" asp-for="ProducerPhone" class="form-control"
                               name="ProducerPhone"
                               maxlength="25" required placeholder="Max 25 characters">
                    </div>
                    <span class="text-danger" asp-validation-for="ProducerPhone"></span>
                </div>
            </div>

            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="ProducerEmail" class="form-label" asp-for="ProducerEmail">Producer Email Address</label>
                    <input class="form-control" asp-for="ProducerEmail"
                           id="ProducerEmail" name="ProducerEmail"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="ProducerEmail"></span>
                </div>

                <div class="col-md-6">
                    <label for="ProducerWebsite" class="form-label" asp-for="ProducerWebsite">Producer Website(Optional)</label>
                    <input class="form-control" asp-for="ProducerWebsite"
                           id="ProducerWebsite" name="ProducerWebsite"
                           maxlength="100" placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="ProducerWebsite"></span>
                </div>
            </div>
        </div>

        @* <-- FILM WORK OPERATION CERTIFICATE --> *@

        <b2 class="col-md-10 offset-md-1"><strong>FILM WORK OPERATION CERTIFICATE</strong></b2>

        <div id="film-work-operation-container" class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="col-md-12">
                <label for="UploadedFile" class="form-label">Upload PDF</label>
                <input type="file" class="form-control" id="UploadedFile" name="UploadedFile" accept=".pdf">
                <span class="text-danger" asp-validation-for="UploadedFile"></span>
            </div>
        </div>

        @* <-- --> *@

        <div class="row">
            <div class="col-md-10 offset-md-1 text-start">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </div>
    </form>
</div>


@* Text fields red glow *@
<style>

    /* Light green border for success */
    .border-success {
        border-color: #90ee90 !important; /* Light green color */
        border-width: 2px !important; /* Bolder border */
    }

    /* Dark red border for error */
    .border-danger {
        border-color: red !important; /* Dark red color */
        /* border-width: 2px !important; /* Bolder border */ */
    }


    /* Director and Producer */
    /* Red border for error */
    .border-danger-director {
        border-color: #a94442 !important; /* Dark red color */
        border-width: 2px !important; /* Bolder border */
    }

    .border-danger-producer {
        border-color: #a94442 !important; /* Dark red color */
        border-width: 2px !important; /* Bolder border */
    }

    /* Light green border for success */
    .border-success-director {
        border-color: #90ee90 !important; /* Light green color */
        border-width: 2px !important; /* Bolder border */
    }

    .border-success-producer {
        border-color: #90ee90 !important; /* Light green color */
        border-width: 2px !important; /* Bolder border */
    }


    /* Movie Time Length */
    #MovieTimeLength {
        border-color: red; /* Default border color red */
    }

        #MovieTimeLength:disabled {
            background-color: #f8d7da; /* Slightly red background for disabled state */
            color: #6c757d; /* Gray text color */
        }

        #MovieTimeLength.is-valid {
            border-color: green; /* Border color turns green when valid */
        }

        #MovieTimeLength.is-invalid {
            border-color: red; /* Border color stays red when invalid */
        }
</style>
