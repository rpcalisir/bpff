                    </div>
                    <span class="text-danger" asp-validation-for="ProducerPhone"></span>
                </div>
            </div>

            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="ProducerEmail" class="form-label" asp-for="ProducerEmail">Producer Email Address</label>
                    <input class="form-control" asp-for="ProducerEmail"
                           id="ProducerEmail" name="ProducerEmail"
