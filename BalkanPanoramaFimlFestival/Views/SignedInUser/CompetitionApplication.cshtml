        function updateHiddenFieldProducerCountry() {
            var producerCountrySelect = document.getElementById('CountrySelectProducer');
            var producerCountryName = document.getElementById('ProducerCountryName');

            if (producerCountrySelect && producerCountryName) {
                var selectedCountryText = producerCountrySelect.options[producerCountrySelect.selectedIndex].text;
                producerCountryName.value = selectedCountryText;
            }
        }

        function validateProducerInfo() {
            var producerContainer = document.getElementById('producer-container');
            var requiredElements = producerContainer.querySelectorAll('input[required], select[required], textarea[required]');
            var allValid = true;

            // Check each required element
            requiredElements.forEach(function (element) {
                if (!element.value.trim()) {
                    allValid = false;
                    element.classList.add('border-danger');
                    element.classList.remove('border-success');
                } else {
                    element.classList.add('border-success');
                    element.classList.remove('border-danger');
                }
            });

            // Validate country selection separately
            var producerCountry = document.getElementById('CountrySelectProducer');
            var countryError = document.getElementById('CountryErrorProducer');
            if (producerCountry && producerCountry.value === "") {
                allValid = false;
                producerCountry.classList.add('border-danger');
                producerCountry.classList.remove('border-success');
                countryError.style.display = "block";
            } else if (producerCountry) {
                producerCountry.classList.add('border-success');
                producerCountry.classList.remove('border-danger');
                countryError.style.display = "none";
            }

            // Ensure container border color updates based on the validity of all required fields
            if (allValid) {
                producerContainer.classList.add('border-success');
                producerContainer.classList.remove('border-danger');
            } else {
                producerContainer.classList.add('border-danger');
                producerContainer.classList.remove('border-success');
            }

            return allValid; // Return whether the producer info is valid
        }

        // Attach the update function to country select change event
        document.getElementById('CountrySelectProducer').addEventListener('change', function () {
            updateHiddenFieldProducerCountry();
            validateProducerInfo(); // Validate on change
        });

        // Attach the validation function to the form submit event
        document.querySelector('form').addEventListener('submit', function (event) {
            if (!validateProducerInfo()) {
                event.preventDefault(); // Prevent form submission if there are errors
            }
        });

        // Attach the validation function to each required input's input/change event
        document.querySelectorAll('#producer-container input[required], #producer-container select[required], #producer-container textarea[required]').forEach(function (element) {
            element.addEventListener('input', validateProducerInfo);
            element.addEventListener('change', validateProducerInfo); // For select elements
        });
    </script>

