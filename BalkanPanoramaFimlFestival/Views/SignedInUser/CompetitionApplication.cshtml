    @* UploadedMoviePictures Upload Check Script *@
    @* UploadedMoviePictures Upload Check Script *@
    <script>
        function validateMoviePicturesUpload() {
            var uploadedPicturesInput = document.getElementById('UploadedMoviePictures');
            var errorMessages = document.getElementById('errorMessages');
            var maxFiles = 5;
            var maxSizeInMB = 10;
            var maxSizeInBytes = maxSizeInMB * 1024 * 1024;

            var totalSize = 0;
            var files = uploadedPicturesInput.files;
            var hasFiles = files.length > 0;

            // Calculate total file size
            for (var i = 0; i < files.length; i++) {
                totalSize += files[i].size;
            }

            var tooManyFiles = files.length > maxFiles;
            var exceedsSizeLimit = totalSize > maxSizeInBytes;

            // Prepare error messages
            var messages = [];
            if (!hasFiles) {
                messages.push('At least 1 movie picture must be uploaded.');
            }
            if (tooManyFiles) {
                messages.push(`You can upload a maximum of ${maxFiles} pictures.`);
            }
            if (exceedsSizeLimit) {
                messages.push(`The total size of the uploaded pictures must be less than ${maxSizeInMB} MB.`);
            }

            // Show or clear error messages and set border color based on validation
            if (messages.length > 0) {
                errorMessages.textContent = messages.join(' ');
                uploadedPicturesInput.style.borderColor = 'red'; // Set border color to red on error
            } else {
                errorMessages.textContent = '';
                uploadedPicturesInput.style.borderColor = 'green'; // Set border color to green if no error
            }
        }

        // Attach the validation function to the file input's change event
        document.getElementById('UploadedMoviePictures').addEventListener('change', function () {
            validateMoviePicturesUpload();
        });

        // Validate the file input on form submission
        document.querySelector('form').addEventListener('submit', function (event) {
            var uploadedPicturesInput = document.getElementById('UploadedMoviePictures');
            var totalSize = 0;
            var files = uploadedPicturesInput.files;
            var maxFiles = 5;
            var maxSizeInBytes = 10 * 1024 * 1024;

            // Calculate total file size
            for (var i = 0; i < files.length; i++) {
                totalSize += files[i].size;
            }

            var tooManyFiles = files.length > maxFiles;
            var exceedsSizeLimit = totalSize > maxSizeInBytes;

            if (files.length === 0 || tooManyFiles || exceedsSizeLimit) {
                validateMoviePicturesUpload();
                event.preventDefault(); // Prevent form submission if validation fails
                uploadedPicturesInput.focus(); // Add focus to the file input
            }
        });
    </script>

    @* UploadedMoviePoster Upload Check Script *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const uploadedMoviePosterInput = document.getElementById('UploadedMoviePoster');
            const errorMessages = document.getElementById('posterErrorMessages');

            function validateMoviePosterUpload() {
                const files = uploadedMoviePosterInput.files;
                const maxFiles = 1;
                const maxSizeInMB = 3;
                const maxSizeInBytes = maxSizeInMB * 1024 * 1024;

                let errorMessagesArray = [];
                let totalSize = 0;

                // Calculate total size of uploaded files
                for (let i = 0; i < files.length; i++) {
                    totalSize += files[i].size;
                }

                const tooManyFiles = files.length > maxFiles;
                const exceedsSizeLimit = totalSize > maxSizeInBytes;

                // Determine error messages based on validation
                if (tooManyFiles) {
                    errorMessagesArray.push(`You can upload a maximum of ${maxFiles} picture.`);
                }
                if (exceedsSizeLimit) {
                    errorMessagesArray.push(`The total size of the uploaded picture must be less than ${maxSizeInMB} MB.`);
                }
                if (files.length === 0) {
                    errorMessagesArray.push('A movie poster must be uploaded.');
                }

                // Update border color and error messages
                if (errorMessagesArray.length > 0) {
                    errorMessages.textContent = errorMessagesArray.join(' ');
                    uploadedMoviePosterInput.style.borderColor = 'red'; // Set border color to red on error
                } else {
                    errorMessages.textContent = '';
                    uploadedMoviePosterInput.style.borderColor = 'green'; // Set border color to green if no error
                }
            }

            // Attach the validation function to the file input's change event
            uploadedMoviePosterInput.addEventListener('change', function () {
                validateMoviePosterUpload();
            });

            // Validate on form submission
            document.querySelector('form').addEventListener('submit', function (event) {
                const files = uploadedMoviePosterInput.files;
                const maxFiles = 1;

