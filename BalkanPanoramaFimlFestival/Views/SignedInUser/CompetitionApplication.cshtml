    <script>
        function validateCountries() {
            var selectedCountries = document.querySelectorAll('input[name="SelectedCountries"]:checked');
            var validationMessageCountry = document.getElementById('validation-message-country');
            var hasError = false;

            // Validate countries
            if (selectedCountries.length === 0) {
                validationMessageCountry.textContent = "Please select at least one country!";
                hasError = true;
            } else if (selectedCountries.length > 5) {
                validationMessageCountry.textContent = "Max 5 countries can be selected!";
                hasError = true;
            } else {
                validationMessageCountry.textContent = "";
            }

            // Update border color based on country selection
            var countryContainer = document.getElementById('countries-container');
            if (selectedCountries.length === 0) {
                countryContainer.classList.add('border-danger');
                countryContainer.classList.remove('border-success');
            } else if (selectedCountries.length > 5) {
                countryContainer.classList.add('border-danger');
                countryContainer.classList.remove('border-success');
            }
            else {
                countryContainer.classList.add('border-success');
                countryContainer.classList.remove('border-danger');
            }

            return !hasError; // Return whether there are errors
        }

        // Attach the validation function to the form submit event
        // If this is not added, nothing happens after clicking the submit button
        document.querySelector('form').addEventListener('submit', function (event) {
            if (!validateCountries()) {
                event.preventDefault(); // Prevent form submission if there are errors
            }
        });

        // Attach the validation function to checkbox change events
        document.querySelectorAll('input[name="SelectedCountries"]').forEach(checkbox => {
            checkbox.addEventListener('change', validateCountries);
        });
    </script>

