@model CompetitionApplicationUserViewModel

@{
    ViewData["Title"] = "CompetitionApplication";
}

@* Client side validation script *@
@section Scripts
{
    <script>
        @await Html.PartialAsync("PartialScripts/_ValidationScriptsPartial")
    </script>

    @* Countries and Genres Selection Script *@
    <script>
        document.querySelector('form').addEventListener('submit', function (event) {
            var selectedCountries = document.querySelectorAll('input[name="SelectedCountries"]:checked');
            var selectedMovieGenres = document.querySelectorAll('input[name="SelectedMovieGenres"]:checked');
            var validationMessageCountry = document.getElementById('validation-message-country');
            var validationMessageGenre = document.getElementById('validation-message-genre');

            var hasError = false;

            // Validate countries
            if (selectedCountries.length === 0) {
                validationMessageCountry.textContent = "Please select at least one country!";
                hasError = true;
            } else if (selectedCountries.length > 3) {
                validationMessageCountry.textContent = "Max 3 countries can be selected!";
                hasError = true;
            } else {
                validationMessageCountry.textContent = "";
            }

            // Validate movie genres
            if (selectedMovieGenres.length === 0) {
                validationMessageGenre.textContent = "Please select at least one movie genre!";
                hasError = true;
            } else if (selectedMovieGenres.length > 3) {
                validationMessageGenre.textContent = "Max 3 movie genres can be selected!";
                hasError = true;
            } else {
                validationMessageGenre.textContent = "";
            }

            // Prevent form submission if there are errors
            if (hasError) {
                event.preventDefault(); // Prevent the form from submitting
            }
        });
    </script>

    @* Phone Number Script *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var directorPhoneInput = document.querySelector("#director-phone");
            var producerPhoneInput = document.querySelector("#producer-phone");

            // Initialize intlTelInput for Director Phone
            if (directorPhoneInput) {
                window.intlTelInput(directorPhoneInput, {
                    initialCountry: "tr", // Set your default country here
                    utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js" // for formatting
                });
            }

            // Initialize intlTelInput for Producer Phone
            if (producerPhoneInput) {
                window.intlTelInput(producerPhoneInput, {
                    initialCountry: "tr", // Set your default country here
                    utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js" // for formatting
                });
            }
        });
    </script>

    @* Country Selector Script *@
     <script>
        document.addEventListener("DOMContentLoaded", function () {
            function initializeCountrySelector(countrySelectId, countryErrorId, hiddenFieldId) {
                var countrySelect = document.getElementById(countrySelectId);
                var countryError = document.getElementById(countryErrorId);
                var form = document.querySelector('form');
                var hiddenField = document.getElementById(hiddenFieldId);

                // Fetch the list of countries from an external API
                fetch('https://restcountries.com/v3.1/all')
                    .then(response => response.json())
                    .then(data => {
                        // Populate the select element with options
                        data.forEach(country => {
                            if (country.name && country.cca2) {
                                var option = document.createElement('option');
                                option.value = country.cca2;
                                option.textContent = country.name.common;
                                countrySelect.appendChild(option);
                            }
                        });
                    })
                    .catch(error => {
                        console.error('Error fetching countries:', error);
                    });

                // Validate the form on submit
                form.addEventListener('submit', function (event) {
                    var selectedCountryCode = countrySelect.value;
                    var selectedCountryName = countrySelect.options[countrySelect.selectedIndex].text;

                    // Reset the error message
                    countryError.style.display = 'none';
                    countryError.textContent = '';

                    if (selectedCountryCode === '') {
                        countryError.textContent = 'Please select a country.';
                        countryError.style.display = 'block';
                        event.preventDefault(); // Prevent form submission
                    } else {
                        // Set the hidden field value to the country name
                        hiddenField.value = selectedCountryName;
                    }
                });
            }

            // Initialize for ProducerCountry
            initializeCountrySelector('CountrySelectProducer', 'CountryErrorProducer', 'ProducerCountryName');

            // Initialize for DirectorCountry
            initializeCountrySelector('CountrySelectDirector', 'CountryErrorDirector', 'DirectorCountryName');
        });
    </script> 

    @* Character Left on Textbox Script *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Character limit handling for DirectorBiographyTr
            var textareaDirectorBiographyTr = document.getElementById('DirectorBiographyTr');
            var charCountDirectorBiographyTr = document.getElementById('charCountDirectorBiographyTr');

            textareaDirectorBiographyTr.addEventListener('input', function () {
                var remaining = 1000 - this.value.length;
                charCountDirectorBiographyTr.textContent = remaining;
            });

            // Character limit handling for DirectorBiographyEn
            var textareaDirectorBiographyEn = document.getElementById('DirectorBiographyEn');
            var charCountDirectorBiographyEn = document.getElementById('charCountDirectorBiographyEn');

            textareaDirectorBiographyEn.addEventListener('input', function () {
                var remaining = 1000 - this.value.length;
                charCountDirectorBiographyEn.textContent = remaining;
            });

            // Character limit handling for DirectorFilmographyTr
            var textareaDirectorFilmographyTr = document.getElementById('DirectorFilmographyTr');
            var charCountDirectorFilmographyTr = document.getElementById('charCountDirectorFilmographyTr');

            textareaDirectorFilmographyTr.addEventListener('input', function () {
                var remaining = 1000 - this.value.length;
                charCountDirectorFilmographyTr.textContent = remaining;
            });

            // Character limit handling for DirectorFilmographyEn
            var textareaDirectorFilmographyEn = document.getElementById('DirectorFilmographyEn');
            var charCountDirectorFilmographyEn = document.getElementById('charCountDirectorFilmographyEn');

            textareaDirectorFilmographyEn.addEventListener('input', function () {
                var remaining = 1000 - this.value.length;
                charCountDirectorFilmographyEn.textContent = remaining;
            });

            // Character limit handling for MovieScript
            var textareaMovieScript = document.getElementById('MovieScript');
            var charCountMovieScript = document.getElementById('charCountMovieScript');

            textareaMovieScript.addEventListener('input', function () {
                var remaining = 1000 - this.value.length;
                charCountMovieScript.textContent = remaining;
            });

            // Character limit handling for MovieActors
            var textareaMovieActors = document.getElementById('MovieActors');
            var charCountMovieActors = document.getElementById('charCountMovieActors');

            textareaMovieActors.addEventListener('input', function () {
                var remaining = 1000 - this.value.length;
                charCountMovieActors.textContent = remaining;
            });

            // Character limit handling for MovieFiction
            var textareaMovieFiction = document.getElementById('MovieFiction');
            var charCountMovieFictions = document.getElementById('charCountMovieFiction');

            textareaMovieFiction.addEventListener('input', function () {
                var remaining = 1000 - this.value.length;
                charCountMovieFictions.textContent = remaining;
            });
        });
    </script>

}

@* @{
    // Takes Countries from get CompetitionApplication action method
    var countries = ViewBag.Countries as List<string>;
} *@

<h1 class="text-center mb-5">COMPETITION APPLICATION</h1>

<div class="container">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-info" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @* General errors related to application (comes from ModelState) for client side validation in the form *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form asp-controller="SignedInUser" asp-action="CompetitionApplication" method="post">

        @* <-- CATEGORY --> *@

        <b2 class="col-md-10 offset-md-1"><strong>CHOOSE COMPETITION CATEGORY</strong></b2>

        <div class="row mb-3">
            <div class="col-md-10 offset-md-1">
                <div class="form-check form-check-inline">
                    <input type="radio" asp-for="CompetitionCategory" value="Option1" class="form-check-input" id="option1" />
                    <label class="form-check-label" for="option1">SARI ŞEMSİYE ULUSAL UZUN METRAJ FİLM YARIŞMASI</label>
                </div>

                <div class="form-check form-check-inline mx-3">
                    <input type="radio" asp-for="CompetitionCategory" value="Option2" class="form-check-input" id="option2" />
                    <label class="form-check-label" for="option2">SARI ŞEMSİYE ULUSAL KISA METRAJ FİLM YARIŞMASI</label>
                </div>

                <div class="form-check form-check-inline">
                    <input type="radio" asp-for="CompetitionCategory" value="Option3" class="form-check-input" id="option3" />
                    <label class="form-check-label" for="option3">DARIO MORENO</label>
                </div>

                @* Display validation errors for the specific field *@
                @* Errors comes from model *@
                <div class="text-danger mb-3">
                    <span asp-validation-for="CompetitionCategory"></span>
                </div>
            </div>
        </div>

        @* <-- GENERAL INFORMATION --> *@

        <b2 class="col-md-10 offset-md-1"><strong>GENERAL INFORMATION</strong></b2>

        <div class="row mb-3 col-md-10 offset-md-1 border border-secondary rounded p-3">
            <div class="row mb-3 col-md-12">
                <div class="col-md-6">
                    <label for="OriginalMovieName" class="form-label" asp-for="OriginalMovieName">Original Movie Name</label>
                    <input class="form-control" asp-for="OriginalMovieName"
                           id="OriginalMovieName" name="OriginalMovieName"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="OriginalMovieName"></span>
                </div>

                <div class="col-md-6">
                    <label for="EnglishMovieName" class="form-label" asp-for="EnglishMovieName">English Movie Name</label>
                    <input class="form-control" asp-for="EnglishMovieName"
                           id="EnglishMovieName" name="EnglishMovieName"
                           maxlength="100" required placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="EnglishMovieName"></span>
                </div>
            </div>

            <div class="row mb-3 col-md-12">
                <div class="col-md-12">
                    <label for="MovieWebsite" class="form-label" asp-for="MovieWebsite">Movie Website (Optional)</label>
                    <input class="form-control" asp-for="MovieWebsite"
                           id="MovieWebsite" name="MovieWebsite"
                           maxlength="100" placeholder="Max 100 characters">
                    <div class="form-text"></div>
                    <span class="text-danger" asp-validation-for="MovieWebsite"></span>
                </div>
            </div>
        </div>

        @* <-- COUNTRIES --> *@

        <b2 class="col-md-10 offset-md-1"><strong>SELECT COUNTRIES(MAX 3)</strong></b2>

        <div class="row mb-3">
            <div class="col-md-10 offset-md-1">
                <div id="country-selection" class="border border-secondary rounded p-3">
                    <div class="d-flex flex-wrap">
                        @for (int i = 0; i < Model.AllCountries.Count; i++)
                        {
                            <div class="col-md-4 col-lg-3 mb-3">
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="country-@i"
                                           name="SelectedCountries"
                                           value="@Model.AllCountries[i]" />
                                    <label class="form-check-label" for="country-@i">@Model.AllCountries[i]</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @* error comes from JS script, generates error for client side validation *@
                <span class="text-danger" id="validation-message-country"></span>
            </div>
        </div>

        @* <-- GENRES --> *@

        <b2 class="col-md-10 offset-md-1"><strong>MOVIE GENRES(MAX 3)</strong></b2>

        <div class="row mb-3">
            <div class="col-md-10 offset-md-1">
                <div id="genre-selection" class="border border-secondary rounded p-3">
                    <div class="d-flex flex-wrap">
                        @for (int i = 0; i < Model.AllMovieGenres.Count; i++)
                        {
                            <div class="col-md-4 col-lg-3 mb-3">
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="genre-@i"
                                           name="SelectedMovieGenres"
                                           value="@Model.AllMovieGenres[i]" />
                                    <label class="form-check-label" for="genre-@i">@Model.AllMovieGenres[i]</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @* error comes from JS script, generates error for client side validation *@
                <span class="text-danger" id="validation-message-genre"></span>
            </div>
        </div>

        @* <-- PRODUCTION YEAR --> *@

