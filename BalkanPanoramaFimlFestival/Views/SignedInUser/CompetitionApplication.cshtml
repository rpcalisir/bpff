        function validateDirectorInfo() {
            var directorContainer = document.getElementById('director-container');
            var requiredElements = directorContainer.querySelectorAll('input[required], select[required], textarea[required]');
            var allValid = true;

            // Check each required element
            requiredElements.forEach(function (element) {
