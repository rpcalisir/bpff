    @* If there is no enctype="multipart/form-data" attribute, then UploadedPdfFile is null *@
    <form asp-controller="SignedInUser" asp-action="CompetitionApplication" method="post" enctype="multipart/form-data">

        @* <-- CATEGORY --> *@

