                        errorMessages.push(`The photo size must be less than ${maxSizeInMB} MB.`);
                    } else {
                        UploadedBestActorPhotoInput.style.borderColor = 'green';
                    }
                }

                // Validate name input
                if (bestActorNameInput.value.trim() === '') {
                    bestActorNameInput.style.borderColor = 'red';
                    errorMessages.push('Actor name must be provided.');
                } else {
                    bestActorNameInput.style.borderColor = 'green';
                }

                // Update error messages
                if (errorMessages.length > 0) {
                    UploadedBestActorPhotoErrorMessages.textContent = errorMessages.join(' ');
                } else {
                    UploadedBestActorPhotoErrorMessages.textContent = '';
                }

                // Focus on the first invalid field
                if (errorMessages.length > 0) {
                    if (UploadedBestActorPhotoInput.style.borderColor === 'red') {
                        UploadedBestActorPhotoInput.focus();
                    } else if (bestActorNameInput.style.borderColor === 'red') {
                        bestActorNameInput.focus();
                    }
                }
            }

            // Attach event listeners
            optCbUploadedBestActorPhoto.addEventListener('change', validateUploadedBestActorPhoto);
            UploadedBestActorPhotoInput.addEventListener('change', validateUploadedBestActorPhoto);
            bestActorNameInput.addEventListener('input', validateUploadedBestActorPhoto);

            // Validate on form submission
            document.querySelector('form').addEventListener('submit', function (event) {
                const files = UploadedBestActorPhotoInput.files;
                if (!optCbUploadedBestActorPhoto.checked && (files.length === 0 || files.length > 1 || bestActorNameInput.value.trim() === '')) {
                    validateUploadedBestActorPhoto();
                    event.preventDefault(); // Prevent form submission if validation fails
                    if (UploadedBestActorPhotoInput.style.borderColor === 'red') {
                        UploadedBestActorPhotoInput.focus(); // Focus on file input
                    } else if (bestActorNameInput.style.borderColor === 'red') {
                        bestActorNameInput.focus(); // Focus on name input
                    }
                }
            });
        });
    </script>

