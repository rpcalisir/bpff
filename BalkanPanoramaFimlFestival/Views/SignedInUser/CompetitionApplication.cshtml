    <script>
        function validateFileUpload() {
            var container = document.getElementById('film-work-operation-container');
            var fileInput = document.getElementById('UploadedFile');
            var fileUploaded = fileInput.files.length > 0;

            // Update border color of the container based on file upload status
            if (fileUploaded) {
                container.classList.add('border-success');
                container.classList.remove('border-danger');
            } else {
                container.classList.add('border-danger');
                container.classList.remove('border-success');
            }
        }

        // Attach the validation function to the file input's change event
        document.getElementById('UploadedFile').addEventListener('change', validateFileUpload);

        // Optionally, you may want to validate the file input on form submission
        document.querySelector('form').addEventListener('submit', function (event) {
            if (document.getElementById('UploadedFile').files.length === 0) {
                validateFileUpload();
                event.preventDefault(); // Prevent form submission if no file is uploaded
            }
        });
