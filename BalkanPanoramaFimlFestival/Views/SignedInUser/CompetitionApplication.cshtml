    <script>
        document.addEventListener('DOMContentLoaded', (event) => {
            // Regulations Elements
            const IHaveReadAndApproveCheckbox = document.getElementById('IHaveReadAndApproveCheckbox');
            const IHaveReadAndApproveError = document.getElementById('IHaveReadAndApproveError');

            // Submit Button Logic
            document.querySelector('button[type="submit"]').addEventListener('click', function (event) {
                const form = event.target.closest('form'); // Get the form element
                const isFormValid = form.checkValidity(); // Check if the form is valid without submitting

                if (isFormValid) {
                    let isValid = true;

                    if (!IHaveReadAndApproveCheckbox.checked) {
                        IHaveReadAndApproveError.style.display = 'block';
                        isValid = false;
                    } else {
                        IHaveReadAndApproveError.style.display = 'none';
                    }

                    if (!isValid) {
                        event.preventDefault(); // Prevent form submission if validation fails
                        IHaveReadAndApproveCheckbox.focus(); // Set focus on the checkbox after validation
                    }
                }
            });

            // Add an event listener to hide the error message immediately after the checkbox is checked
            IHaveReadAndApproveCheckbox.addEventListener('change', function () {
                if (IHaveReadAndApproveCheckbox.checked) {
                    IHaveReadAndApproveError.style.display = 'none';
                }
            });
        });
    </script>
