<div style="display: flex; justify-content: center; align-items: flex-start; height: 100vh;">
    <table class="table table-striped" style="width: 100%;">
        <thead>
            <tr>
                <th>ORDER</th>
                <th style="min-width: 200px;">CATEGORY</th>
                <th>PRODUCTION YEAR</th>
                <th>APPLICANT NAME</th>
                <th>APPLICANT EMAIL</th>
                <th>APPLICANT COUNTRY</th>
                <th>MOVIE NAME</th>
                <th>DIRECTOR</th>
                <th>ALL MEDIA</th>
                <th>INSPECT</th>
                <th>MOVIE INFORMATION</th>
                <th>DELETE</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                var categoryStyle = "";

                if (item.CompetitionCategory == "SARI ŞEMSİYE ULUSAL UZUN METRAJ FİLM YARIŞMASI")
                {
                    categoryStyle = "background-color: yellow; color: black;";
                }
                else if (item.CompetitionCategory == "SARI ŞEMSİYE ULUSAL KISA METRAJ FİLM YARIŞMASI")
                {
                    categoryStyle = "background-color: red; color: white;";
                }
                else if (item.CompetitionCategory == "DARIO MORENO")
                {
                    categoryStyle = "background-color: blue; color: white;";
                }

                <tr>
                    <td>@item.Id</td>
                    <td style="@categoryStyle !important">@item.CompetitionCategory</td>
                    <td>@item.ProductionYear</td>
                    <td>@item.ApplicantName</td>
                    <td>@item.ApplicantEmail</td>
                    <td>@item.ApplicantCountry</td>
                    <td>@item.OriginalMovieName</td>
                    <td>@item.DirectorName</td>
                    <td>
                        @if (
                       !string.IsNullOrEmpty(item.UploadedMoviePicturesFilePaths) &&
                       !string.IsNullOrEmpty(item.UploadedMoviePosterFilePath) &&
                       !string.IsNullOrEmpty(item.UploadedDirectorPhotoFilePath)
                       )
                        {
                            <a href="@Url.Action("DownloadAllFiles", "Home", new
                            {
                                applicantEmail = item.ApplicantEmail,
                                UploadedPdfFilePath = item.UploadedPdfFilePath ?? string.Empty,
                                UploadedMoviePicturesFilePaths = string.Join(",", item.UploadedMoviePicturesFilePaths),
                                UploadedMoviePosterFilePath = item.UploadedMoviePosterFilePath ?? string.Empty,
                                UploadedMovieSubtitleFilePath = item.UploadedMovieSubtitleFilePath ?? string.Empty,
                                UploadedDirectorPhotoFilePath = item.UploadedDirectorPhotoFilePath ?? string.Empty,
                                UploadedBestActressPhotoFilePath = item.UploadedBestActressPhotoFilePath ?? string.Empty,
                                UploadedBestActorPhotoFilePath = item.UploadedBestActorPhotoFilePath ?? string.Empty
                            })" class="btn btn-primary">Download All Media Files</a>
                        }
                        else
                        {
                            <span>No Media File Uploaded</span>
                        }

                    </td>
                    <td>
                        <a href="@Url.Action("DownloadMovieInformation", "Home",
                    new { id = item.Id })" class="btn btn-primary">Download Movie Information</a>
                    </td>
                    <td>
                        <a href="@Url.Action("InspectMovieInformation", "Home", new { id = item.Id })" class="btn btn-info">Inspect</a> <!-- Inspect button -->
                    </td>
                    <td>
                        <form asp-action="DeleteCompetitionApplication" method="post" onsubmit="return confirm('Are you sure you want to delete this item?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
