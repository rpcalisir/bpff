@model List<CompetitionApplicationUserViewModel>

@{
    ViewData["Title"] = "CompetitionApplications";
}

<h1>Competition Applications</h1>

<table class="table table-success table-striped">
    <thead>
        <tr>
            <th>Category</th>
            <th>Production Year</th>
            <th>Applicant</th>
            <th>Email</th>
            <th>Country</th>
            <th>Movie Name</th>
            <th>Director</th>
            <th>Download PDF</th> <!-- Added this column -->
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CompetitionCategory</td>
                <td>@item.ProductionYear</td>
                <td>@item.Applicant</td>
                <td>@item.ApplicantMail</td>
                <td>@item.ApplicantCountry</td>
                <td>@item.DirectorName</td>
                <td>@item.OriginalMovieName</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.UploadedFilePath))
                    {
                        // Pass the relative file path (excluding leading '/')
                        <a href="@Url.Action("DownloadPdf", "Home", 
                        new { Area = "Admin", filePath = item.UploadedFilePath.TrimStart('/') })" 
                        class="btn btn-primary">Download PDF</a>
                    }
                    else
                    {
                        <span>No PDF Uploaded</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
